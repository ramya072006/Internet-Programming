
<!DOCTYPE html>
<html>
<head>
<title>Ko-Matha Dairy Farm</title>
<style>
body{font-family:Arial;margin:0;background:#f4f8ee;color:#333}
header{background:#386641;color:white;text-align:center;padding:25px}
nav{background:#254b30;padding:15px;text-align:center}
nav a{color:white;text-decoration:none;margin:12px}
.container{background:white;width:85%;margin:20px auto;padding:20px;border-radius:10px}
input,select,button{padding:10px;margin:7px;border:1px solid #ccc;border-radius:5px}
button{background:#386641;color:white;border:0;cursor:pointer}
.card{background:#eaf4e4;padding:15px;margin:10px;border-radius:8px}
</style>
</head>
<body>
<header><h1>Ko-Matha Dairy Farm</h1><p>Fresh and Healthy Dairy Products</p></header>
<nav>
<a href="#home">Home</a><a href="#products">Products</a>
<a href="#about">About Us</a><a href="#admin">Admin</a>
</nav>

<div class="container" id="home">
<h2>Welcome to Ko-Matha Dairy Farm</h2>
<p>We provide fresh milk and quality dairy products directly to customers.</p>
</div>

<div class="container" id="about">
<h2>About Us</h2>
<p>Ko-Matha Dairy Farm focuses on quality dairy production, cow care and customer satisfaction.</p>
</div>

<div class="container" id="products">
<h2>Our Products</h2>
<div id="productList"></div>
<h3>Purchase Product</h3>
<input id="customer" placeholder="Customer Name">
<select id="product">
<option>Fresh Milk</option><option>Curd</option>
<option>Cova Sweet</option><option>Butter</option><option>Ghee</option>
</select>
<input id="quantity" type="number" placeholder="Quantity">
<button onclick="purchase()">Order Now</button>
<p id="orderMsg"></p>
</div>

<div class="container">
<h2>Customer Online Orders</h2>
<div id="orders"></div>
</div>

<div class="container" id="admin">
<h2>Administrator Login</h2>
<input id="adminName" placeholder="Username">
<input id="adminPassword" type="password" placeholder="Password">
<button onclick="login()">Login</button>
<p id="loginMsg"></p>

<h2>Stock Entry</h2>
<select id="stockProduct">
<option>Milk</option><option>Curd</option><option>Butter</option><option>Ghee</option>
</select>
<input id="stockQty" type="number" placeholder="Stock Quantity">
<button onclick="addStock()">Add Stock</button>
<div id="stockReport"></div>

<h2>Vendor Details</h2>
<input id="vendor" placeholder="Vendor Name">
<input id="vendorPhone" placeholder="Vendor Phone">
<button onclick="addVendor()">Add Vendor</button>
<div id="vendorList"></div>

<h2>Cow Maintenance</h2>
<input id="cowId" placeholder="Cow ID">
<input id="cowBreed" placeholder="Cow Breed">
<button onclick="addCow()">Add Cow</button>
<div id="cowList"></div>

<h2>Reports</h2>
<button onclick="report()">Generate Daily Report</button>
<p id="reportMsg"></p>
</div>

<div class="container">
<h2>Contact Us</h2>
<p>Email: contact@komathadairy.com</p>
<p>Phone: 9876543210</p>
</div>

<script>
let prices={"Fresh Milk":50,"Curd":40,"Cova Sweet":100,"Butter":120,"Ghee":200};
let stock={};
let orderList=[];
let vendors=[];
let cows=[];

function displayProducts(){
productList.innerHTML="";
for(let p in prices){
productList.innerHTML+=`<div class="card"><h3>${p}</h3>
<p>Price: Rs.${prices[p]}</p></div>`;
}
}
function purchase(){
let q=Number(quantity.value);
if(!customer.value||q<=0){alert("Enter valid order details");return;}
let total=q*prices[product.value];
orderList.push({customer:customer.value,product:product.value,quantity:q,total:total});
orderMsg.innerText="Order placed! Total: Rs."+total;
displayOrders();
}
function displayOrders(){
orders.innerHTML="";
orderList.forEach(o=>{
orders.innerHTML+=`<div class="card">${o.customer} - ${o.product}
- Quantity: ${o.quantity} - Rs.${o.total}</div>`;
});
}
function login(){
loginMsg.innerText=adminName.value==="admin"&&adminPassword.value==="1234"?"Login Successful":"Invalid Login";
}
function addStock(){
let q=Number(stockQty.value);
if(q<=0){alert("Enter valid stock");return;}
stock[stockProduct.value]=(stock[stockProduct.value]||0)+q;
stockReport.innerHTML=Object.entries(stock).map(x=>"<p>"+x[0]+": "+x[1]+"</p>").join("");
}
function addVendor(){
if(!vendor.value||!vendorPhone.value){alert("Enter vendor details");return;}
vendors.push(vendor.value+" - "+vendorPhone.value);
vendorList.innerHTML=vendors.map(v=>"<p>"+v+"</p>").join("");
}
function addCow(){
if(!cowId.value||!cowBreed.value){alert("Enter cow details");return;}
cows.push(cowId.value+" - "+cowBreed.value);
cowList.innerHTML=cows.map(c=>"<p>"+c+"</p>").join("");
}
function report(){
reportMsg.innerText="Daily Report: "+orderList.length+" orders, "+vendors.length+" vendors and "+cows.length+" cows.";
}
displayProducts();
</script>
</body>
</html>
