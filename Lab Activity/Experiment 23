
<!DOCTYPE html>
<html>
<head>
<title>Blood Management System</title>
<style>
body{font-family:Arial;background:#fff0f0;margin:0}
header{background:#b51f35;color:white;text-align:center;padding:20px}
.container{background:white;width:85%;margin:20px auto;padding:20px;border-radius:10px}
input,select,button{padding:10px;margin:7px;border:1px solid #ccc;border-radius:5px}
button{background:#c62828;color:white;border:0;cursor:pointer}
.card{padding:12px;background:#ffe5e5;margin:10px;border-radius:7px}
</style>
</head>
<body>
<header><h1>Blood Management Information System</h1></header>

<div class="container">
<h2>Donor Registration</h2>
<input id="donorName" placeholder="Donor Name">
<input id="donorAge" type="number" placeholder="Age">
<input id="donorPhone" placeholder="Phone Number">
<select id="bloodGroup">
<option>A+</option><option>A-</option><option>B+</option>
<option>B-</option><option>O+</option><option>O-</option>
<option>AB+</option><option>AB-</option>
</select>
<input id="donorCity" placeholder="City">
<button onclick="addDonor()">Register Donor</button>
<p id="donorMsg"></p>
</div>

<div class="container">
<h2>Search Blood Donors</h2>
<select id="searchGroup">
<option value="">Select Blood Group</option>
<option>A+</option><option>A-</option><option>B+</option>
<option>B-</option><option>O+</option><option>O-</option>
<option>AB+</option><option>AB-</option>
</select>
<button onclick="searchDonor()">Search</button>
<div id="donorResults"></div>
</div>

<div class="container">
<h2>Hospital Registration</h2>
<input id="hospitalName" placeholder="Hospital Name">
<input id="hospitalCity" placeholder="City">
<select id="hospitalGroup">
<option>A+</option><option>A-</option><option>B+</option>
<option>B-</option><option>O+</option><option>O-</option>
<option>AB+</option><option>AB-</option>
</select>
<input id="units" type="number" placeholder="Available Units">
<button onclick="addHospital()">Register Blood Bank</button>
</div>

<div class="container">
<h2>Available Blood Banks</h2>
<div id="hospitalList"></div>
</div>

<script>
let donors=[];
let hospitals=[];

function addDonor(){
if(!donorName.value||!donorAge.value||!donorPhone.value||!donorCity.value){
alert("Fill all donor details");return;
}
donors.push({
name:donorName.value,
age:donorAge.value,
phone:donorPhone.value,
group:bloodGroup.value,
city:donorCity.value
});
donorMsg.innerText="Donor registered successfully!";
}

function searchDonor(){
let group=searchGroup.value;
donorResults.innerHTML="";
let result=donors.filter(d=>d.group===group);
if(result.length===0){
donorResults.innerHTML="No donors found";
}
result.forEach(d=>{
donorResults.innerHTML+=`<div class="card">
Name: ${d.name}<br>Blood Group: ${d.group}<br>
City: ${d.city}<br>Phone: ${d.phone}
</div>`;
});
}

function addHospital(){
if(!hospitalName.value||!hospitalCity.value||!units.value){
alert("Enter hospital details");return;
}
hospitals.push({
name:hospitalName.value,
city:hospitalCity.value,
group:hospitalGroup.value,
units:units.value
});
displayHospitals();
alert("Blood bank registered successfully");
}

function displayHospitals(){
hospitalList.innerHTML="";
hospitals.forEach(h=>{
hospitalList.innerHTML+=`<div class="card">
${h.name}<br>City: ${h.city}<br>
Blood Group: ${h.group}<br>Available Units: ${h.units}
</div>`;
});
}
</script>
</body>
</html>
