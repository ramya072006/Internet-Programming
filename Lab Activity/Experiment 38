
<!DOCTYPE html>
<html>
<head>
<title>My Professional Showcase</title>
<style>
body{font-family:Arial;margin:0;background:#f4f6fa;color:#222}
header{background:#243b67;color:white;text-align:center;padding:40px}
nav{background:#172747;text-align:center;padding:15px}
nav a{color:white;text-decoration:none;margin:15px}
section{background:white;margin:20px auto;padding:25px;max-width:850px;border-radius:10px}
h2{color:#243b67}
.project{background:#eef2fa;padding:15px;margin:10px 0;border-radius:7px}
button{padding:10px;background:#243b67;color:white;border:0;cursor:pointer}
</style>
</head>
<body>
<header>
<h1>My Professional Showcase</h1>
<p>Student | Web Developer | Programmer</p>
</header>
<nav>
<a href="#about">About</a>
<a href="#skills">Skills</a>
<a href="#projects">Projects</a>
<a href="#contact">Contact</a>
</nav>
<section id="about">
<h2>About Me</h2>
<p>Hello! I am a student interested in programming and web development. I enjoy learning new technologies and developing useful applications.</p>
</section>
<section id="skills">
<h2>My Skills</h2>
<ul>
<li>HTML and CSS</li>
<li>JavaScript</li>
<li>Java Programming</li>
<li>Python</li>
<li>Database Management</li>
</ul>
</section>
<section id="projects">
<h2>My Projects</h2>
<div class="project"><h3>Online Shopping Website</h3><p>A website to browse products and manage a shopping cart.</p></div>
<div class="project"><h3>Task Management System</h3><p>An application to create and organize daily tasks.</p></div>
<div class="project"><h3>Student Management System</h3><p>A system to manage student information.</p></div>
</section>
<section id="contact">
<h2>Contact Me</h2>
<input id="name" placeholder="Your Name"><br><br>
<input id="email" type="email" placeholder="Your Email"><br><br>
<textarea id="message" placeholder="Your Message"></textarea><br><br>
<button onclick="sendMessage()">Send Message</button>
<p id="result"></p>
</section>
<script>
function sendMessage(){
let n=document.getElementById("name").value;
let e=document.getElementById("email").value;
let m=document.getElementById("message").value;
if(n===""||e===""||m===""){
alert("Please fill all fields");
return;
}
document.getElementById("result").innerHTML="Thank you "+n+". Your message has been received.";
}
</script>
</body>
</html>
