
<!DOCTYPE html>
<html>
<head>
<title>Smart Shopping</title>
<style>
body{font-family:Arial;margin:0;background:#f3f4f6}
header{background:#174b75;color:white;text-align:center;padding:22px}
nav{background:#10334f;padding:13px;text-align:center}
nav a{color:white;margin:15px;text-decoration:none}
.container{max-width:950px;margin:25px auto;padding:15px}
.products{display:flex;flex-wrap:wrap;gap:20px}
.product{background:white;padding:18px;width:220px;text-align:center;border-radius:10px;box-shadow:0 2px 7px #ccc}
.product img{width:100%;height:140px;object-fit:cover}
button{background:#174b75;color:white;padding:10px;border:0;border-radius:5px;cursor:pointer}
#cart{background:white;padding:20px;margin-top:25px;border-radius:10px}
input{padding:10px;width:80%;margin:15px 0}
</style>
</head>
<body>
<header><h1>Smart Shopping</h1><p>Online Shopping Made Easy</p></header>
<nav>
<a href="#products">Products</a>
<a href="#cart">Cart</a>
</nav>
<div class="container">
<h2>Search Products</h2>
<input id="search" placeholder="Search products..." onkeyup="searchProducts()">
<h2 id="products">Available Products</h2>
<div class="products">
<div class="product" data-name="smartphone">
<img src="https://placehold.co/250x150?text=Smartphone">
<h3>Smartphone</h3><p>₹15,000</p>
<button onclick="addCart('Smartphone',15000)">Add to Cart</button>
</div>
<div class="product" data-name="laptop">
<img src="https://placehold.co/250x150?text=Laptop">
<h3>Laptop</h3><p>₹45,000</p>
<button onclick="addCart('Laptop',45000)">Add to Cart</button>
</div>
<div class="product" data-name="headphones">
<img src="https://placehold.co/250x150?text=Headphones">
<h3>Headphones</h3><p>₹2,000</p>
<button onclick="addCart('Headphones',2000)">Add to Cart</button>
</div>
</div>
<div id="cart">
<h2>Shopping Cart</h2>
<ul id="items"></ul>
<h3 id="total">Total: ₹0</h3>
<button onclick="placeOrder()">Place Order</button>
</div>
</div>
<script>
let total=0;
function addCart(name,price){
let item=document.createElement("li");
item.textContent=name+" - ₹"+price;
document.getElementById("items").appendChild(item);
total+=price;
document.getElementById("total").innerHTML="Total: ₹"+total;
}
function searchProducts(){
let value=document.getElementById("search").value.toLowerCase();
document.querySelectorAll(".product").forEach(p=>{
p.style.display=p.dataset.name.includes(value)?"block":"none";
});
}
function placeOrder(){
if(total===0){
alert("Please add products to your cart");
return;
}
alert("Order placed successfully! Total amount: ₹"+total);
document.getElementById("items").innerHTML="";
total=0;
document.getElementById("total").innerHTML="Total: ₹0";
}
</script>
</body>
</html>
