<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SkyBook | Flight Reservation System</title>

<style>
:root {
  --navy: #102a43;
  --blue: #1769ff;
  --blue-dark: #1054d4;
  --light: #edf5ff;
  --bg: #f5f8fc;
  --white: #ffffff;
  --text: #24364b;
  --muted: #738198;
  --border: #e2eaf4;
  --green: #12805c;
  --red: #d94848;
  --shadow: 0 12px 35px rgba(25, 61, 105, .08);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: Inter, "Segoe UI", Arial, sans-serif;
  background: var(--bg);
  color: var(--text);
  line-height: 1.55;
}

button, input, select, textarea {
  font: inherit;
}

button {
  border: 0;
  border-radius: 10px;
  padding: 12px 18px;
  cursor: pointer;
  font-weight: 700;
  transition: transform .2s, background .2s, box-shadow .2s;
}

button:hover:not(:disabled) {
  transform: translateY(-2px);
}

button:disabled {
  opacity: .45;
  cursor: not-allowed;
}

.primary {
  background: var(--blue);
  color: white;
  box-shadow: 0 5px 14px rgba(23, 105, 255, .17);
}

.primary:hover:not(:disabled) {
  background: var(--blue-dark);
}

.secondary {
  background: #eaf2ff;
  color: var(--navy);
}

.danger {
  background: #fff0f0;
  color: var(--red);
}

.hidden {
  display: none !important;
}

/* NAVIGATION */

header {
  position: sticky;
  top: 0;
  z-index: 10;
  background: rgba(255, 255, 255, .96);
  backdrop-filter: blur(14px);
  border-bottom: 1px solid var(--border);
  padding: 15px 5%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  flex-wrap: wrap;
}

.brand {
  font-size: 27px;
  font-weight: 850;
  letter-spacing: -.8px;
  color: var(--navy);
}

.brand span {
  color: var(--blue);
}

nav {
  display: flex;
  gap: 5px;
  flex-wrap: wrap;
  align-items: center;
}

nav button {
  background: transparent;
  color: #62738b;
  padding: 10px 12px;
  font-size: 13px;
  border-radius: 9px;
}

nav button:hover,
nav button.active {
  background: #eaf2ff;
  color: var(--blue);
}

/* MAIN LAYOUT */

.container {
  width: min(1200px, 92%);
  margin: 35px auto 65px;
  min-height: 65vh;
}

h1, h2, h3 {
  color: var(--navy);
  line-height: 1.25;
}

h1 {
  font-size: clamp(28px, 4vw, 39px);
  letter-spacing: -1px;
}

h2 {
  font-size: 26px;
  letter-spacing: -.5px;
}

h3 {
  font-size: 19px;
}

.page-title {
  margin-bottom: 8px;
}

.subtitle {
  color: var(--muted);
  margin-bottom: 28px;
}

.muted {
  color: var(--muted);
  line-height: 1.6;
}

/* HERO SECTION */

.hero {
  position: relative;
  overflow: hidden;
  padding: clamp(30px, 6vw, 65px);
  border-radius: 28px;
  color: white;
  background:
    radial-gradient(circle at 85% 15%, rgba(84, 169, 255, .38), transparent 28%),
    linear-gradient(125deg, #102747 0%, #124a91 52%, #1976d2 100%);
  box-shadow: 0 20px 45px rgba(16, 42, 67, .16);
}

.hero > p:first-child {
  display: inline-block;
  padding: 8px 13px;
  margin: 0;
  border: 1px solid rgba(255, 255, 255, .3);
  background: rgba(255, 255, 255, .1);
  color: #ffffff;
  border-radius: 30px;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 2px;
}

.hero h1 {
  color: #ffffff;
  font-size: clamp(35px, 5.5vw, 58px);
  max-width: 720px;
  line-height: 1.1;
  margin: 22px 0 15px;
  letter-spacing: -1.8px;
  text-shadow: 0 2px 12px rgba(0, 0, 0, .12);
}

.hero > p:not(:first-child) {
  color: #f0f6ff;
  max-width: 650px;
  line-height: 1.8;
}

.search-panel {
  margin-top: 35px;
  color: var(--text);
  border: 1px solid rgba(255, 255, 255, .45);
  box-shadow: 0 15px 40px rgba(4, 23, 50, .16);
}

/* PANELS AND CARDS */

.panel,
.feature,
.flight,
.ticket {
  background: white;
  border: 1px solid var(--border);
  border-radius: 17px;
  padding: 24px;
  margin-bottom: 18px;
  box-shadow: 0 5px 20px rgba(25, 61, 105, .035);
}

.panel h3:first-child {
  margin-top: 0;
}

.features {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
  margin-top: 22px;
}

.feature {
  padding: 26px;
  transition: transform .2s, box-shadow .2s;
}

.feature:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow);
}

.feature h3 {
  margin-top: 4px;
}

.feature p {
  color: var(--muted);
  line-height: 1.8;
  margin-bottom: 0;
}

/* FORMS */

.grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;
}

.grid.three {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.search-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
}

label {
  display: block;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: .25px;
  margin-bottom: 8px;
  color: #53647b;
}

input,
select,
textarea {
  width: 100%;
  padding: 13px 14px;
  border: 1px solid #dce5f0;
  border-radius: 10px;
  background: #fbfdff;
  color: var(--text);
  outline: none;
  transition: border .2s, box-shadow .2s, background .2s;
}

input:hover,
select:hover,
textarea:hover {
  border-color: #b8cce7;
}

input:focus,
select:focus,
textarea:focus {
  background: white;
  border-color: var(--blue);
  box-shadow: 0 0 0 4px rgba(23, 105, 255, .1);
}

.actions {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin-top: 22px;
}

/* FLIGHT RESULTS */

.flight-list {
  display: grid;
  gap: 16px;
  margin-top: 20px;
}

.flight {
  display: grid;
  grid-template-columns: 1fr 1.35fr 1fr auto;
  align-items: center;
  gap: 22px;
  padding: 24px;
  transition: transform .2s, box-shadow .2s, border-color .2s;
}

.flight:hover {
  transform: translateY(-3px);
  border-color: #bcd5ff;
  box-shadow: var(--shadow);
}

.flight strong {
  color: var(--navy);
}

.route {
  font-size: 21px;
  font-weight: 800;
  color: var(--navy);
}

.route small {
  display: block;
  margin-top: 5px;
  font-size: 12px;
  font-weight: 500;
  color: var(--muted);
}

.price {
  font-size: 25px;
  font-weight: 850;
  color: var(--blue);
  white-space: nowrap;
}

.notice {
  padding: 16px 18px;
  background: #eaf8f0;
  color: #176b4d;
  border: 1px solid #c9ead7;
  border-radius: 12px;
  margin: 16px 0;
  line-height: 1.65;
}

.error {
  background: #fff0f0;
  color: #a12d2d;
  border-color: #f3cece;
}

/* SEAT SELECTION */

.seats {
  display: grid;
  grid-template-columns: repeat(6, 42px);
  justify-content: center;
  gap: 10px;
  margin: 25px 0;
  padding: 25px 15px;
  background: #f6f9fd;
  border: 1px solid var(--border);
  border-radius: 15px;
}

.seat {
  background: #dcf7e7;
  color: #167347;
  padding: 10px 0;
  border-radius: 8px;
  font-size: 12px;
}

.seat:hover:not(:disabled) {
  background: #bcebd0;
}

.seat.selected {
  background: var(--blue);
  color: white;
}

.seat.taken {
  background: #e5e9f0;
  color: #8995a7;
}

/* TABLES AND ADMIN DASHBOARD */

.table-wrap {
  overflow-x: auto;
  border: 1px solid var(--border);
  border-radius: 12px;
}

table {
  width: 100%;
  border-collapse: collapse;
  font-size: 13px;
  background: white;
}

th,
td {
  padding: 15px;
  border-bottom: 1px solid var(--border);
  text-align: left;
  white-space: normal;
}

th {
  background: #f0f5fc;
  color: #51647d;
  font-weight: 800;
}

tbody tr:hover {
  background: #f8fbff;
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
  margin: 25px 0;
}

.stat {
  background: white;
  border: 1px solid var(--border);
  padding: 24px;
  border-radius: 16px;
  color: var(--muted);
  box-shadow: 0 5px 20px rgba(25, 61, 105, .035);
}

.stat strong {
  display: block;
  color: var(--blue);
  font-size: 30px;
  margin-top: 10px;
}

/* E-TICKET */

.ticket {
  overflow: hidden;
  padding: 24px;
}

.ticket-head {
  background: linear-gradient(120deg, #102747, #1769c2);
  color: white;
  margin: -24px -24px 25px;
  padding: 25px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 15px;
}

.ticket-head strong {
  color: white;
  font-size: 19px;
}

.ticket-route {
  display: flex;
  justify-content: space-between;
  gap: 15px;
  align-items: center;
  margin: 35px 0;
  padding: 10px 0;
}

.ticket-route strong {
  font-size: 30px;
  color: var(--navy);
}

.ticket-info {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 22px;
  border-top: 1px dashed #cbd6e5;
  padding-top: 25px;
}

.ticket-info span {
  display: block;
  font-size: 11px;
  color: var(--muted);
  margin-bottom: 6px;
  text-transform: uppercase;
  letter-spacing: .5px;
}

.ticket-info strong {
  overflow-wrap: anywhere;
}

/* FEEDBACK */

.stars button {
  background: transparent;
  color: #e6a52c;
  font-size: 24px;
  padding: 3px;
}

/* FOOTER AND TOAST */

footer {
  background: #102747;
  color: #e5efff;
  padding: 30px 20px;
  text-align: center;
  line-height: 1.8;
}

#toast {
  position: fixed;
  bottom: 22px;
  right: 22px;
  background: #102747;
  color: white;
  padding: 15px 20px;
  border-radius: 12px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, .2);
  z-index: 100;
  max-width: 90%;
}

/* TABLET */

@media (max-width: 1000px) {
  header {
    padding: 14px 4%;
  }

  nav {
    gap: 2px;
  }

  nav button {
    padding: 8px;
  }

  .search-grid,
  .grid.three {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .flight {
    grid-template-columns: 1fr 1fr;
  }

  .flight button {
    grid-column: 1 / -1;
  }
}

/* MOBILE */

@media (max-width: 600px) {
  header {
    position: static;
    align-items: flex-start;
  }

  .brand {
    font-size: 24px;
  }

  nav {
    width: 100%;
  }

  nav button {
    font-size: 12px;
    padding: 8px 9px;
  }

  .container {
    width: 92%;
    margin-top: 20px;
  }

  .hero {
    padding: 25px 20px;
    border-radius: 20px;
  }

  .hero h1 {
    font-size: 36px;
    letter-spacing: -1px;
  }

  .panel,
  .feature,
  .flight {
    padding: 19px;
  }

  .search-grid,
  .grid,
  .grid.three,
  .features,
  .stats {
    grid-template-columns: 1fr;
  }

  .flight {
    grid-template-columns: 1fr;
    gap: 15px;
  }

  .flight button {
    grid-column: auto;
    width: 100%;
  }

  .ticket-route strong {
    font-size: 22px;
  }

  .ticket-info {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .seats {
    grid-template-columns: repeat(6, minmax(0, 35px));
    gap: 6px;
    padding: 18px 8px;
  }

  .seat {
    padding: 9px 0;
    font-size: 11px;
  }

  .actions button {
    flex: 1 1 auto;
  }

  .ticket-head {
    margin: -19px -19px 20px;
    padding: 20px;
  }
}

/* PRINT TICKET */

@media print {
  body {
    background: white;
  }

  header,
  footer,
  .no-print,
  #toast {
    display: none !important;
  }

  .container {
    width: 100%;
    margin: 0;
  }

  .page.hidden {
    display: none !important;
  }

  #page-ticket {
    display: block !important;
  }

  .ticket {
    border: 1px solid #aaa;
    box-shadow: none;
  }
}
</style>
</head>

<body>

<header>
  <div class="brand">✈ <span>SkyBook</span></div>
  <nav id="navigation">
    <button class="active" data-page="home">Home</button>
    <button data-page="search">Search Flights</button>
    <button data-page="mytickets">My Tickets</button>
    <button data-page="status">Booking Status</button>
    <button data-page="cancel">Cancel Ticket</button>
    <button data-page="feedback">Feedback</button>
    <button data-page="admin">Admin</button>
    <button data-page="login" id="loginButton">Sign In</button>
  </nav>
</header>

<main class="container">

<!-- HOME PAGE -->
<section id="page-home" class="page">
  <div class="hero">
    <p>YOUR JOURNEY STARTS HERE</p>
    <h1>Fly farther. Travel smarter.</h1>
    <p>Search flights, choose your seat, book your journey and manage your tickets in one place.</p>

    <div class="panel search-panel">
      <h3>Find your flight</h3>
      <div class="search-grid">
        <div>
          <label>From</label>
          <select id="homeFrom">
            <option>Mumbai</option><option>Delhi</option><option>Bengaluru</option>
            <option>Hyderabad</option><option>Chennai</option><option>Kolkata</option><option>Goa</option>
          </select>
        </div>
        <div>
          <label>Destination</label>
          <select id="homeTo">
            <option>Delhi</option><option>Mumbai</option><option>Bengaluru</option>
            <option>Hyderabad</option><option>Chennai</option><option>Kolkata</option><option>Goa</option>
          </select>
        </div>
        <div><label>Departure date</label><input type="date" id="homeDate"></div>
        <div>
          <label>Travel class</label>
          <select id="homeClass">
            <option>Economy</option><option>Business</option><option>First Class</option>
          </select>
        </div>
        <div>
          <label>Passengers</label>
          <select id="homePassengers">
            <option>1</option><option>2</option><option>3</option><option>4</option><option>5</option>
          </select>
        </div>
      </div>
      <div class="actions"><button class="primary" onclick="searchFromHome()">Search Flights →</button></div>
    </div>
  </div>

  <h2>Why choose SkyBook?</h2>
  <div class="features">
    <div class="feature"><h3>✈ Flight Search</h3><p>Compare sample airlines, fares, departure times and available seats.</p></div>
    <div class="feature"><h3>🎫 E-Tickets</h3><p>View, save and print your booking details and travel itinerary.</p></div>
    <div class="feature"><h3>🧳 Easy Management</h3><p>Check booking status, request cancellation and manage reservations.</p></div>
  </div>
</section>

<!-- SEARCH PAGE -->
<section id="page-search" class="page hidden">
  <h1 class="page-title">Search Flights</h1>
  <p class="subtitle">Choose your route and travel preferences.</p>

  <div class="panel">
    <div class="search-grid">
      <div><label>Origin</label>
        <select id="from">
          <option>Mumbai</option><option>Delhi</option><option>Bengaluru</option>
          <option>Hyderabad</option><option>Chennai</option><option>Kolkata</option><option>Goa</option>
        </select>
      </div>
      <div><label>Destination</label>
        <select id="to">
          <option>Delhi</option><option>Mumbai</option><option>Bengaluru</option>
          <option>Hyderabad</option><option>Chennai</option><option>Kolkata</option><option>Goa</option>
        </select>
      </div>
      <div><label>Departure date</label><input type="date" id="travelDate"></div>
      <div><label>Travel class</label>
        <select id="travelClass"><option>Economy</option><option>Business</option><option>First Class</option></select>
      </div>
      <div><label>Passengers</label>
        <select id="passengers"><option>1</option><option>2</option><option>3</option><option>4</option><option>5</option></select>
      </div>
      <div><label>Sort by</label>
        <select id="sortBy"><option value="price">Lowest fare</option><option value="time">Departure time</option></select>
      </div>
    </div>
    <div class="actions">
      <button class="primary" onclick="searchFlights()">Find Flights</button>
      <button class="secondary" onclick="swapRoute()">⇄ Swap Route</button>
    </div>
  </div>
  <div id="flightResults"></div>
</section>

<!-- LOGIN / REGISTER PAGE -->
<section id="page-login" class="page hidden">
  <h1>Passenger Account</h1>
  <p class="subtitle">Sign in or create an account.</p>
  <div class="panel" style="max-width:650px">
    <div class="grid">
      <div><label>Full name</label><input id="authName" placeholder="Enter your name"></div>
      <div><label>Email address</label><input id="authEmail" type="email" placeholder="you@example.com"></div>
      <div><label>Password</label><input id="authPassword" type="password" placeholder="Minimum 4 characters"></div>
      <div><label>Account action</label>
        <select id="authMode"><option value="login">Sign In</option><option value="register">Register</option></select>
      </div>
    </div>
    <div class="actions">
      <button class="primary" onclick="authenticate()">Continue</button>
      <button class="secondary" onclick="showPage('forgot')">Forgot Password?</button>
      <button class="secondary" onclick="logout()">Sign Out</button>
    </div>
    <div id="authMessage"></div>
    <p class="muted">Demonstration only: this standalone version does not use a secure server for account authentication.</p>
  </div>
</section>

<!-- FORGOT PASSWORD -->
<section id="page-forgot" class="page hidden">
  <h1>Forgot Password</h1>
  <p class="subtitle">Request demo password-reset instructions.</p>
  <div class="panel" style="max-width:600px">
    <label>Registered email</label>
    <input type="email" id="forgotEmail" placeholder="you@example.com">
    <div class="actions"><button class="primary" onclick="resetPassword()">Reset Password</button></div>
    <div id="forgotMessage"></div>
  </div>
</section>

<!-- BOOK TICKET -->
<section id="page-book" class="page hidden">
  <h1>Book Your Ticket</h1>
  <p class="subtitle">Enter passenger details and select a seat.</p>
  <div class="panel" id="chosenFlight"></div>

  <div class="panel">
    <h3>Passenger Details</h3>
    <div class="grid">
      <div><label>Full name as on ID</label><input id="pName" placeholder="Passenger name"></div>
      <div><label>Email</label><input id="pEmail" type="email" placeholder="passenger@example.com"></div>
      <div><label>Phone number</label><input id="pPhone" type="tel" maxlength="10" placeholder="10-digit number"></div>
      <div><label>Age</label><input id="pAge" type="number" min="1" max="110" placeholder="Age"></div>
    </div>

    <h3>Choose Your Seat</h3>
    <p class="muted">Green: available · Blue: selected · Grey: unavailable</p>
    <div class="seats" id="seatGrid"></div>
    <p id="seatMessage" class="muted">Select one available seat.</p>

    <div class="actions">
      <button class="primary" onclick="continuePayment()">Continue to Payment</button>
      <button class="secondary" onclick="showPage('search')">Back</button>
    </div>
  </div>
</section>

<!-- PAYMENT PAGE -->
<section id="page-payment" class="page hidden">
  <h1>Ticket Payment</h1>
  <p class="subtitle">Review your fare and confirm your demonstration booking.</p>
  <div class="panel" style="max-width:750px">
    <div id="paymentSummary"></div>
    <div style="margin-top:18px">
      <label>Payment Method</label>
      <select id="paymentMethod">
        <option>UPI (Demo)</option>
        <option>Credit / Debit Card (Demo)</option>
        <option>Net Banking (Demo)</option>
        <option>Pay at Counter (Demo)</option>
      </select>
    </div>
    <div class="notice">No real payment is processed. Do not enter real card details. A production payment gateway requires secure backend integration.</div>
    <div class="actions">
      <button class="primary" onclick="confirmBooking()">Confirm Booking</button>
      <button class="secondary" onclick="showPage('book')">Back</button>
    </div>
  </div>
</section>

<!-- MY TICKETS -->
<section id="page-mytickets" class="page hidden">
  <h1>My Tickets</h1>
  <p class="subtitle">View your booking history and travel itineraries.</p>
  <div id="ticketList"></div>
</section>

<!-- PRINTABLE TICKET -->
<section id="page-ticket" class="page hidden">
  <div class="actions no-print">
    <button class="primary" onclick="window.print()">Print E-Ticket</button>
    <button class="secondary" onclick="showPage('mytickets')">Back to My Tickets</button>
  </div>
  <div id="ticketDetail"></div>
</section>

<!-- BOOKING STATUS -->
<section id="page-status" class="page hidden">
  <h1>View Booking Status</h1>
  <p class="subtitle">Check your reservation using the PNR reference.</p>
  <div class="panel" style="max-width:700px">
    <label>Booking Reference / PNR</label>
    <input id="pnrInput" placeholder="Example: SBABC123">
    <div class="actions"><button class="primary" onclick="checkStatus()">Check Status</button></div>
    <div id="statusResult"></div>
  </div>
</section>

<!-- CANCEL TICKET -->
<section id="page-cancel" class="page hidden">
  <h1>Cancel Ticket</h1>
  <p class="subtitle">Submit a cancellation request for your reservation.</p>
  <div class="panel" style="max-width:700px">
