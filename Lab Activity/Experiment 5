<div id="toast" class="hidden"></div>

<script>
"use strict";

const $ = id => document.getElementById(id);

const cities = [
  "Mumbai", "Delhi", "Bengaluru", "Hyderabad",
  "Chennai", "Kolkata", "Goa"
];

const defaultFlights = [
  {id:1, airline:"IndiGo", code:"6E 204", from:"Mumbai", to:"Delhi", departure:"06:20", arrival:"08:35", fare:4299, seats:24},
  {id:2, airline:"Air India", code:"AI 672", from:"Mumbai", to:"Delhi", departure:"09:10", arrival:"11:25", fare:4890, seats:18},
  {id:3, airline:"Akasa Air", code:"QP 1102", from:"Mumbai", to:"Delhi", departure:"13:40", arrival:"15:55", fare:3999, seats:12},
  {id:4, airline:"IndiGo", code:"6E 532", from:"Bengaluru", to:"Goa", departure:"07:30", arrival:"08:45", fare:3199, seats:20},
  {id:5, airline:"Air India Express", code:"IX 2874", from:"Delhi", to:"Hyderabad", departure:"11:00", arrival:"13:10", fare:3899, seats:16},
  {id:6, airline:"IndiGo", code:"6E 611", from:"Chennai", to:"Bengaluru", departure:"17:15", arrival:"18:20", fare:2799, seats:14},
  {id:7, airline:"SpiceJet", code:"SG 8152", from:"Kolkata", to:"Mumbai", departure:"15:30", arrival:"18:25", fare:5199, seats:10},
  {id:8, airline:"Air India", code:"AI 541", from:"Hyderabad", to:"Chennai", departure:"19:00", arrival:"20:20", fare:2999, seats:19},
  {id:9, airline:"IndiGo", code:"6E 721", from:"Delhi", to:"Chennai", departure:"08:30", arrival:"11:20", fare:4599, seats:22},
  {id:10, airline:"Akasa Air", code:"QP 603", from:"Chennai", to:"Mumbai", departure:"14:15", arrival:"16:20", fare:3499, seats:18},
  {id:11, airline:"Air India", code:"AI 890", from:"Bengaluru", to:"Hyderabad", departure:"12:00", arrival:"13:10", fare:2599, seats:15},
  {id:12, airline:"IndiGo", code:"6E 415", from:"Goa", to:"Bengaluru", departure:"16:00", arrival:"17:15", fare:3299, seats:16}
];

function load(key, fallback) {
  try {
    const value = localStorage.getItem("skybook_" + key);
    return value === null ? fallback : JSON.parse(value);
  } catch (e) {
    return fallback;
  }
}

function save(key, value) {
  localStorage.setItem("skybook_" + key, JSON.stringify(value));
}

let flights = load("flights", defaultFlights);
let bookings = load("bookings", []);
let cancellations = load("cancellations", []);
let feedback = load("feedback", []);
let users = load("users", []);
let currentUser = load("user", null);
let selectedFlight = null;
let selectedSeat = "";
let adminUnlocked = false;
let currentPNR = "";

const today = new Date();
const dateString = d => {
  const x = new Date(d);
  x.setMinutes(x.getMinutes() - x.getTimezoneOffset());
  return x.toISOString().slice(0, 10);
};

$("homeDate").min = dateString(today);
$("travelDate").min = dateString(today);
$("homeDate").value = dateString(today);
$("travelDate").value = dateString(today);

function persistAll() {
  save("flights", flights);
  save("bookings", bookings);
  save("cancellations", cancellations);
  save("feedback", feedback);
  save("users", users);
  save("user", currentUser);
}

function esc(value) {
  return String(value ?? "").replace(/[&<>"']/g, ch => ({
    "&": "&amp;",
    "<": "&lt;",
    ">": "&gt;",
    '"': "&quot;",
    "'": "&#39;"
  })[ch]);
}

function money(value) {
  return "₹" + Number(value).toLocaleString("en-IN");
}

function toast(message) {
  $("toast").textContent = message;
  $("toast").classList.remove("hidden");
  setTimeout(() => $("toast").classList.add("hidden"), 3000);
}

function showPage(page) {
  document.querySelectorAll(".page").forEach(section => section.classList.add("hidden"));
  const target = $("page-" + page);
  if (target) target.classList.remove("hidden");

  document.querySelectorAll("#navigation button[data-page]").forEach(button => {
    button.classList.toggle("active", button.dataset.page === page);
  });

  if (page === "mytickets") renderTickets();
  if (page === "feedback") renderFeedback();
  if (page === "admin" && adminUnlocked) renderAdmin();

  window.scrollTo({top:0, behavior:"smooth"});
}

document.querySelectorAll("#navigation button[data-page]").forEach(button => {
  button.addEventListener("click", () => showPage(button.dataset.page));
});

function updateLoginButton() {
  $("loginButton").textContent = currentUser
    ? currentUser.name.split(" ")[0]
    : "Sign In";
}

function searchFromHome() {
  $("from").value = $("homeFrom").value;
  $("to").value = $("homeTo").value;
  $("travelDate").value = $("homeDate").value;
  $("travelClass").value = $("homeClass").value;
  $("passengers").value = $("homePassengers").value;
  showPage("search");
  searchFlights();
}

function swapRoute() {
  const from = $("from").value;
  $("from").value = $("to").value;
  $("to").value = from;
}

function searchFlights() {
  const from = $("from").value;
  const to = $("to").value;
  const date = $("travelDate").value;
  const cls = $("travelClass").value;
  const passengerCount = Number($("passengers").value);

  if (from === to) {
    $("flightResults").innerHTML =
      '<div class="notice error">Origin and destination must be different.</div>';
    return;
  }

  if (!date || date < dateString(today)) {
    $("flightResults").innerHTML =
      '<div class="notice error">Please select a valid departure date.</div>';
    return;
  }

  let results = flights.filter(f => f.from === from && f.to === to);

  if ($("sortBy").value === "time") {
    results.sort((a,b) => a.departure.localeCompare(b.departure));
  } else {
    results.sort((a,b) => a.fare - b.fare);
  }

  results = results.filter(f => availableSeats(f.id, date).length >= passengerCount);

  if (!results.length) {
    $("flightResults").innerHTML =
      '<div class="panel"><h3>No flights available</h3><p class="muted">No sample flights match this route and passenger count. Try another route.</p></div>';
    return;
  }

  const multiplier = cls === "Business" ? 2.3 : cls === "First Class" ? 3.8 : 1;

  $("flightResults").innerHTML =
    '<h2>' + results.length + ' Flight Options</h2>' +
    '<div class="flight-list">' + results.map(f => `
      <div class="flight">
        <div>
          <strong>✈ ${esc(f.airline)}</strong>
          <div class="muted">${esc(f.code)}</div>
        </div>
        <div class="route">
          ${esc(f.departure)} <span class="muted">→</span> ${esc(f.arrival)}
          <small>${esc(f.from)} to ${esc(f.to)}</small>
        </div>
        <div>
          <div class="price">${money(Math.round(f.fare * multiplier))}</div>
          <small class="muted">${availableSeats(f.id,date).length} seats available</small>
        </div>
        <button class="primary" onclick="bookFlight(${f.id})">Select Flight</button>
      </div>
    `).join("") + '</div>' +
    '<p class="muted">Sample flight schedules and fares are for educational use and are not live airline data.</p>';
}

function bookedSeatNames(flightId, date) {
  const taken = [];
  bookings.forEach(b => {
    if (
      Number(b.flight.id) === Number(flightId) &&
      b.flight.date === date &&
      !b.status.includes("Cancelled")
    ) {
      taken.push(b.seat);
    }
  });
  return taken;
}

function seatLabel(n) {
  return String.fromCharCode(65 + Math.floor((n - 1) / 6)) +
         (((n - 1) % 6) + 1);
}

function availableSeats(flightId, date) {
  const unavailable = bookedSeatNames(flightId, date);
  const occupied = [2,5,9,14,19,25,31,33,34,35,36,37]
    .filter(n => n <= 36)
    .map(seatLabel);
  return Array.from({length:36}, (_,i) => seatLabel(i+1))
    .filter(seat => !occupied.includes(seat) && !unavailable.includes(seat));
}

function bookFlight(id) {
  const flight = flights.find(f => f.id === id);
  if (!flight) return;

  selectedFlight = {
    ...flight,
    date: $("travelDate").value,
    cls: $("travelClass").value,
    passengerCount: Number($("passengers").value)
  };

  const multiplier = selectedFlight.cls === "Business" ? 2.3 :
    selectedFlight.cls === "First Class" ? 3.8 : 1;

  selectedFlight.price = Math.round(flight.fare * multiplier);
  selectedSeat = "";

  if (currentUser) {
    $("pName").value = currentUser.name;
    $("pEmail").value = currentUser.email;
  } else {
    $("pName").value = "";
    $("pEmail").value = "";
  }

  $("pPhone").value = "";
  $("pAge").value = "";

  $("chosenFlight").innerHTML = `
    <h3>${esc(flight.airline)} · ${esc(flight.code)}</h3>
    <p>${esc(flight.from)} → ${esc(flight.to)}</p>
    <p>Date: ${esc(selectedFlight.date)} | Class: ${esc(selectedFlight.cls)}</p>
    <p>Departure: ${esc(flight.departure)} | Arrival: ${esc(flight.arrival)}</p>
    <h3>Fare per passenger: ${money(selectedFlight.price)}</h3>
    <p>Passengers: ${selectedFlight.passengerCount}</p>
    <p>Total fare: <strong>${money(selectedFlight.price * selectedFlight.passengerCount)}</strong></p>
  `;

  renderSeats();
  showPage("book");
}

function renderSeats() {
  const seats = availableSeats(selectedFlight.id, selectedFlight.date);
  $("seatGrid").innerHTML = Array.from({length:36}, (_,i) => {
    const name = seatLabel(i+1);
    const taken = !seats.includes(name);
    return `<button type="button" class="seat ${taken ? "taken" : ""}"
      ${taken ? "disabled" : ""}
      onclick="chooseSeat('${name}')">${name}</button>`;
  }).join("");

  $("seatMessage").textContent = "Select one seat for this demonstration booking.";
}

function chooseSeat(name) {
  if (!selectedFlight || !availableSeats(selectedFlight.id, selectedFlight.date).includes(name)) {
    toast("That seat is unavailable.");
    renderSeats();
    return;
  }

  selectedSeat = name;
  document.querySelectorAll(".seat").forEach(button => {
    button.classList.toggle("selected", button.textContent === name);
  });

  $("seatMessage").textContent = "Selected seat: " + name;
}

function continuePayment() {
  const name = $("pName").value.trim();
  const email = $("pEmail").value.trim();
  const phone = $("pPhone").value.trim();
  const age = Number($("pAge").value);

  if (!name || !email.includes("@") || !/^\d{10}$/.test(phone) ||
      age < 1 || age > 110 || !selectedSeat) {
    toast("Enter valid passenger details and select a seat.");
    return;
  }

  if (!selectedFlight ||
      !availableSeats(selectedFlight.id, selectedFlight.date).includes(selectedSeat)) {
    toast("The selected seat is no longer available. Please choose another seat.");
    renderSeats();
    return;
  }

  $("paymentSummary").innerHTML = `
    <h3>Booking Summary</h3>
    <p>Passenger: ${esc(name)}</p>
    <p>Route: ${esc(selectedFlight.from)} → ${esc(selectedFlight.to)}</p>
    <p>Date: ${esc(selectedFlight.date)}</p>
    <p>Seat: ${esc(selectedSeat)}</p>
    <p>Class: ${esc(selectedFlight.cls)}</p>
    <p>Passengers: ${selectedFlight.passengerCount}</p>
    <h2>Total: ${money(selectedFlight.price * selectedFlight.passengerCount)}</h2>
  `;

  showPage("payment");
}

function confirmBooking() {
  if (!selectedFlight || !selectedSeat) {
    toast("Please select a flight and seat first.");
    showPage("search");
    return;
  }

  if (!availableSeats(selectedFlight.id, selectedFlight.date).includes(selectedSeat)) {
    toast("This seat has already been booked. Choose another seat.");
    renderSeats();
    showPage("book");
    return;
  }

  const name = $("pName").value.trim();
  const email = $("pEmail").value.trim();
  const phone = $("pPhone").value.trim();
  const age = Number($("pAge").value);

  if (!name || !email.includes("@") || !/^\d{10}$/.test(phone) ||
      age < 1 || age > 110) {
    toast("Passenger details are invalid.");
    showPage("book");
    return;
  }

  const method = $("paymentMethod").value;
  const pnr = "SB" + Math.random().toString(36).slice(2,8).toUpperCase();

  const booking = {
    pnr,
    flight: {...selectedFlight},
    passenger: {name,email,phone,age},
    seat: selectedSeat,
    price: selectedFlight.price * selectedFlight.passengerCount,
    paymentMethod: method,
    paymentStatus: method.includes("Counter") ? "Pay at Counter (Demo)" : "Demo Payment Confirmed",
    status: "Confirmed (Demo)",
    createdAt: new Date().toLocaleString(),
    cancellation: "None"
  };

  bookings.unshift(booking);

  if (!currentUser) {
    currentUser = {name,email};
  }

  persistAll();
  currentPNR = pnr;
  renderTicket(booking);
  showPage("ticket");
  toast("Demo booking confirmed. PNR: " + pnr);
}

function authenticate() {
  const name = $("authName").value.trim();
  const email = $("authEmail").value.trim().toLowerCase();
  const password = $("authPassword").value;
  const mode = $("authMode").value;

  if (!email.includes("@") || password.length < 4) {
    $("authMessage").innerHTML =
      '<div class="notice error">Enter a valid email and a password of at least 4 characters.</div>';
    return;
  }

  let user = users.find(u => u.email === email);

  if (mode === "register") {
    if (!name) {
      toast("Enter your full name.");
      return;
    }
    if (user) {
      toast("An account already exists for this email.");
      return;
    }
    user = {name,email,password};
    users.push(user);
  } else {
    if (!user || user.password !== password) {
      $("authMessage").innerHTML =
        '<div class="notice error">Account not found or password incorrect. Register first if needed.</div>';
      return;
    }
  }

  currentUser = {name:user.name,email:user.email};
  persistAll();
  updateLoginButton();
  $("authMessage").innerHTML = '<div class="notice">Account action completed for this demo.</div>';
  toast("Welcome to SkyBook!");
  showPage("mytickets");
}

function logout() {
  currentUser = null;
  persistAll();
  updateLoginButton();
  toast("You have signed out.");
  showPage("home");
}

function resetPassword() {
  const email = $("forgotEmail").value.trim().toLowerCase();
  const user = users.find(u => u.email === email);

  $("forgotMessage").innerHTML = email.includes("@")
    ? '<div class="notice">Demo request processed. ' +
      (user ? 'For this lab demo, register a new account if you need to reset your password.' :
      'No matching demo account was found.') +
      ' No email was sent.</div>'
    : '<div class="notice error">Enter a valid email address.</div>';
}

function renderTickets() {
  if (!currentUser) {
    $("ticketList").innerHTML =
      '<div class="panel">Please sign in to view your bookings.' +
      '<div class="actions"><button class="primary" onclick="showPage(\'login\')">Sign In</button></div></div>';
    return;
  }

  const mine = bookings.filter(b =>
    b.passenger.email.toLowerCase() === currentUser.email.toLowerCase()
  );

  $("ticketList").innerHTML = mine.length ? mine.map(b => `
    <div class="panel">
      <h3>${esc(b.flight.from)} → ${esc(b.flight.to)}</h3>
      <p>PNR: <strong>${esc(b.pnr)}</strong></p>
      <p>Date: ${esc(b.flight.date)} | ${esc(b.flight.airline)}</p>
      <p>Status: ${esc(b.status)}</p>
      <div class="actions">
        <button class="primary" onclick="openTicket('${b.pnr}')">View / Print Ticket</button>
        <button class="secondary" onclick="lookupStatus('${b.pnr}')">Booking Status</button>
        ${!b.status.includes("Cancelled") ?
          `<button class="danger" onclick="fillCancel('${b.pnr}')">Cancel Ticket</button>` : ""}
      </div>
    </div>
  `).join("") : '<div class="panel">No bookings found for this account.</div>';
}

function renderTicket(b) {
  currentPNR = b.pnr;
  $("ticketDetail").innerHTML = `
    <div class="ticket">
      <div class="ticket-head">
        <div><strong>✈ SkyBook</strong><br><small>Electronic Flight Ticket</small></div>
        <div><small>BOOKING REFERENCE</small><br><strong>${esc(b.pnr)}</strong></div>
      </div>
      <div class="ticket-route">
        <div><small>${esc(b.flight.from).toUpperCase()}</small><br><strong>${esc(b.flight.departure)}</strong><br>${esc(b.flight.from)}</div>
        <div style="text-align:center"><span>✈</span><br><small>Direct flight (demo)</small></div>
        <div style="text-align:right"><small>${esc(b.flight.to).toUpperCase()}</small><br><strong>${esc(b.flight.arrival)}</strong><br>${esc(b.flight.to)}</div>
      </div>
      <div class="ticket-info">
        <div><span>Passenger</span><strong>${esc(b.passenger.name)}</strong></div>
        <div><span>Travel Date</span><strong>${esc(b.flight.date)}</strong></div>
        <div><span>Flight</span><strong>${esc(b.flight.code)}</strong></div>
        <div><span>Seat / Class</span><strong>${esc(b.seat)} / ${esc(b.flight.cls)}</strong></div>
        <div><span>Total Fare</span><strong>${money(b.price)}</strong></div>
        <div><span>Booking Status</span><strong>${esc(b.status)}</strong></div>
        <div><span>Payment</span><strong>${esc(b.paymentStatus)}</strong></div>
        <div><span>Email</span><strong>${esc(b.passenger.email)}</strong></div>
        <div><span>Booking Time</span><strong>${esc(b.createdAt)}</strong></div>
      </div>
      <p class="muted">Educational demo ticket only. This is not a valid airline boarding pass. No confirmation email has been sent.</p>
    </div>
    <div class="actions no-print">
      ${!b.status.includes("Cancelled") ?
        `<button class="danger" onclick="fillCancel('${b.pnr}')">Request Cancellation</button>` : ""}
    </div>
  `;
}

function openTicket(pnr) {
  const booking = bookings.find(b => b.pnr === pnr);
  if (!booking) return toast("Booking not found.");
  renderTicket(booking);
  showPage("ticket");
}

function checkStatus() {
  const pnr = $("pnrInput").value.trim().toUpperCase();
  const b = bookings.find(x => x.pnr === pnr);

  $("statusResult").innerHTML = b ? `
    <div class="notice">
      <strong>PNR:</strong> ${esc(b.pnr)}<br>
      <strong>Status:</strong> ${esc(b.status)}<br>
      <strong>Route:</strong> ${esc(b.flight.from)} → ${esc(b.flight.to)}<br>
      <strong>Date:</strong> ${esc(b.flight.date)}<br>
      <strong>Passenger:</strong> ${esc(b.passenger.name)}
      <div class="actions"><button class="secondary" onclick="openTicket('${b.pnr}')">View Ticket</button></div>
    </div>
  ` : '<div class="notice error">No booking found for this PNR.</div>';
}

function lookupStatus(pnr) {
  $("pnrInput").value = pnr;
  showPage("status");
  checkStatus();
}

function fillCancel(pnr) {
  $("cancelPnr").value = pnr;
  $("cancelReason").value = "";
  showPage("cancel");
}

function requestCancellation() {
  const pnr = $("cancelPnr").value.trim().toUpperCase();
  const b = bookings.find(x => x.pnr === pnr);

  if (!b) {
    $("cancelMessage").innerHTML = '<div class="notice error">Booking reference not found.</div>';
    return;
  }

  if (b.status.includes("Cancelled")) {
    $("cancelMessage").innerHTML = '<div class="notice">This booking is already cancelled.</div>';
    return;
  }

  if (cancellations.some(c => c.pnr === pnr && c.status === "Pending")) {
    $("cancelMessage").innerHTML = '<div class="notice">A cancellation request is already pending.</div>';
    return;
  }

  const refund = Math.round(b.price * 0.8);

  cancellations.unshift({
    pnr,
    reason: $("cancelReason").value.trim() || "Not specified",
    refund,
    status: "Pending",
    date: new Date().toLocaleString()
  });

  b.cancellation = "Requested";
  persistAll();

  $("cancelMessage").innerHTML =
    `<div class="notice">Cancellation request submitted for ${esc(pnr)}. ` +
    `Illustrative refund: ${money(refund)}. Pending admin review.</div>`;

  if (adminUnlocked) renderAdmin();
}

function submitFeedback() {
  const name = $("feedbackName").value.trim();
  const comment = $("feedbackComment").value.trim();
  const rating = Number($("feedbackRating").value);

  if (!name || !comment) {
    $("feedbackMessage").innerHTML =
      '<div class="notice error">Enter your name and feedback.</div>';
    return;
  }

  feedback.unshift({
    name, comment, rating,
    date: new Date().toLocaleDateString()
  });

  persistAll();
  $("feedbackName").value = "";
  $("feedbackComment").value = "";
  $("feedbackMessage").innerHTML = '<div class="notice">Thank you for your feedback!</div>';

  renderFeedback();
  if (adminUnlocked) renderAdmin();
}

function renderFeedback() {
  $("feedbackList").innerHTML = feedback.length
    ? feedback.slice(0,10).map(f => `
      <div class="panel">
        <strong>${esc(f.name)}</strong>
        <span style="color:#e6a52c">${"★".repeat(f.rating)}${"☆".repeat(5-f.rating)}</span>
        <p>${esc(f.comment)}</p>
        <small class="muted">${esc(f.date)}</small>
      </div>
    `).join("")
    : '<div class="panel">No feedback submitted yet.</div>';
}

function adminLogin() {
  if ($("adminUsername").value === "admin" &&
      $("adminPassword").value === "skyadmin123") {
    adminUnlocked = true;
    $("adminContent").classList.remove("hidden");
    $("adminMessage").innerHTML = '<div class="notice">Administrator login successful.</div>';
    renderAdmin();
  } else {
    $("adminMessage").innerHTML = '<div class="notice error">Incorrect administrator credentials.</div>';
  }
}

function addFlight() {
  const airline = $("newAirline").value.trim();
  const code = $("newCode").value.trim();
  const from = $("newFrom").value;
  const to = $("newTo").value;
  const fare = Number($("newFare").value);
  const seats = Number($("newSeats").value);
  const departure = $("newDeparture").value;
  const arrival = $("newArrival").value;

  if (!airline || !code || from === to || fare <= 0 || seats < 1 ||
      !departure || !arrival) {
    toast("Complete all flight fields with valid values.");
    return;
  }

  flights.push({
    id: Date.now(), airline, code, from, to, fare, seats,
    departure, arrival
  });

  persistAll();
  renderAdmin();
  toast("Flight added successfully.");
}

function deleteFlight(id) {
  flights = flights.filter(f => f.id !== id);
  persistAll();
  renderAdmin();
  toast("Flight removed.");
}

function approveCancellation(pnr) {
  const c = cancellations.find(x => x.pnr === pnr);
  const b = bookings.find(x => x.pnr === pnr);
  if (!c || !b) return;

  c.status = "Approved (Demo)";
  b.status = "Cancelled (Demo)";
  b.paymentStatus = "Refund approved (Demo)";

  persistAll();
  renderAdmin();
  toast("Demo refund approved. No money was transferred.");
}

function rejectCancellation(pnr) {
  const c = cancellations.find(x => x.pnr === pnr);
  if (!c) return;

  c.status = "Rejected";
  persistAll();
  renderAdmin();
  toast("Cancellation request rejected.");
}

function renderAdmin() {
  $("totalBookings").textContent = bookings.length;
  $("totalCancellations").textContent =
    cancellations.filter(c => c.status === "Pending").length;

  const revenue = bookings
    .filter(b => !b.status.includes("Cancelled"))
    .reduce((sum,b) => sum + Number(b.price), 0);

  $("totalRevenue").textContent = money(revenue);

  $("adminFlights").innerHTML = `
    <table><thead><tr>
      <th>Flight</th><th>Route</th><th>Departure</th><th>Fare</th><th>Seats</th><th>Action</th>
    </tr></thead><tbody>
    ${flights.map(f => `
      <tr>
        <td>${esc(f.airline)} (${esc(f.code)})</td>
        <td>${esc(f.from)} → ${esc(f.to)}</td>
        <td>${esc(f.departure)}–${esc(f.arrival)}</td>
        <td>${money(f.fare)}</td>
        <td>${availableSeats(f.id,dateString(today)).length}</td>
        <td><button class="danger" onclick="deleteFlight(${f.id})">Delete</button></td>
      </tr>
    `).join("")}
    </tbody></table>`;

  $("adminBookings").innerHTML = bookings.length ? `
    <table><thead><tr>
      <th>PNR</th><th>Passenger</th><th>Route</th><th>Date</th><th>Fare</th><th>Status</th>
    </tr></thead><tbody>
    ${bookings.map(b => `
      <tr>
        <td>${esc(b.pnr)}</td>
        <td>${esc(b.passenger.name)}<br>${esc(b.passenger.email)}</td>
        <td>${esc(b.flight.from)} → ${esc(b.flight.to)}</td>
        <td>${esc(b.flight.date)}</td>
        <td>${money(b.price)}</td>
        <td>${esc(b.status)}</td>
      </tr>
    `).join("")}
    </tbody></table>` : '<p class="muted">No bookings yet.</p>';

  $("adminCancellations").innerHTML = cancellations.length ? `
    <table><thead><tr>
      <th>PNR</th><th>Reason</th><th>Refund</th><th>Status</th><th>Action</th>
    </tr></thead><tbody>
    ${cancellations.map(c => `
      <tr>
        <td>${esc(c.pnr)}</td><td>${esc(c.reason)}</td>
        <td>${money(c.refund)}</td><td>${esc(c.status)}</td>
        <td>${c.status === "Pending" ? `
          <button class="primary" onclick="approveCancellation('${c.pnr}')">Approve</button>
          <button class="danger" onclick="rejectCancellation('${c.pnr}')">Reject</button>
        ` : "—"}</td>
      </tr>
    `).join("")}
    </tbody></table>` : '<p class="muted">No cancellation requests.</p>';

  $("adminFeedback").innerHTML = feedback.length ? `
    <table><thead><tr><th>Name</th><th>Rating</th><th>Comment</th><th>Date</th></tr></thead><tbody>
    ${feedback.map(f => `
      <tr><td>${esc(f.name)}</td><td>${f.rating}/5</td>
      <td>${esc(f.comment)}</td><td>${esc(f.date)}</td></tr>
    `).join("")}
    </tbody></table>` : '<p class="muted">No feedback yet.</p>';
}

function downloadCSV(filename, rows) {
  const escapeCSV = value => '"' + String(value ?? "").replace(/"/g, '""') + '"';
  const csv = rows.map(row => row.map(escapeCSV).join(",")).join("\r\n");
  const blob = new Blob(["\uFEFF" + csv], {type:"text/csv;charset=utf-8;"});
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = filename;
  document.body.appendChild(a);
  a.click();
  a.remove();
  URL.revokeObjectURL(url);
}

function downloadBookings() {
  downloadCSV("skybook-booking-report.csv", [
    ["PNR","Passenger","Email","Origin","Destination","Date","Flight","Seat","Fare","Payment","Status"],
    ...bookings.map(b => [
      b.pnr,b.passenger.name,b.passenger.email,b.flight.from,b.flight.to,
      b.flight.date,b.flight.code,b.seat,b.price,b.paymentStatus,b.status
    ])
  ]);
}

function downloadFeedback() {
  downloadCSV("skybook-feedback.csv", [
    ["Name","Rating","Comment","Date"],
    ...feedback.map(f => [f.name,f.rating,f.comment,f.date])
  ]);
}

updateLoginButton();
renderFeedback();
</script>
