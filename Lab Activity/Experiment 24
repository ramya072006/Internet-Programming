
<!DOCTYPE html>
<html>
<head>
<title>Wanderlust Travels</title>
<style>
body{font-family:Arial;margin:0;background:#eef6ff}
header{background:#075985;color:white;text-align:center;padding:25px}
nav{background:#123c5a;padding:15px;text-align:center}
nav a{color:white;text-decoration:none;margin:15px}
.container{background:white;padding:20px;margin:20px auto;width:85%;border-radius:10px}
input,select,button{padding:10px;margin:7px;border:1px solid #ccc;border-radius:5px}
button{background:#0284c7;color:white;border:0;cursor:pointer}
.card{display:inline-block;background:#e0f2fe;padding:15px;margin:10px;border-radius:8px}
</style>
</head>
<body>
<header><h1>Wanderlust Travels</h1><p>Explore the World with Us</p></header>
<nav>
<a href="#home">Home</a><a href="#destinations">Destinations</a>
<a href="#booking">Booking</a><a href="#admin">Admin</a>
</nav>

<div class="container" id="home">
<h2>Welcome to Wanderlust Travels</h2>
<p>Discover beautiful destinations, hotels, food and travel routes.</p>
</div>

<div class="container" id="destinations">
<h2>Popular Destinations</h2>
<div class="card"><h3>Kodaikanal</h3><p>Beautiful hill station</p></div>
<div class="card"><h3>Ooty</h3><p>Famous for tea gardens</p></div>
<div class="card"><h3>Munnar</h3><p>Enjoy green landscapes</p></div>
</div>

<div class="container">
<h2>View Food Details</h2>
<select id="food">
<option>South Indian Food</option>
<option>North Indian Food</option>
<option>Continental Food</option>
</select>
<button onclick="showFood()">View Food</button>
<p id="foodMsg"></p>
</div>

<div class="container">
<h2>View Hotel Details</h2>
<select id="hotel">
<option>Budget Hotel</option>
<option>Luxury Hotel</option>
<option>Deluxe Hotel</option>
</select>
<button onclick="showHotel()">View Hotels</button>
<p id="hotelMsg"></p>
</div>

<div class="container">
<h2>View Route Details</h2>
<select id="route">
<option>Chennai to Kodaikanal</option>
<option>Chennai to Ooty</option>
<option>Chennai to Munnar</option>
</select>
<button onclick="showRoute()">View Route</button>
<p id="routeMsg"></p>
</div>

<div class="container" id="booking">
<h2>Book Accommodation</h2>
<input id="customer" placeholder="Customer Name">
<input id="date" type="date">
<select id="room">
<option>Single Room</option>
<option>Double Room</option>
<option>Deluxe Room</option>
</select>
<button onclick="book()">Book Now</button>
<p id="bookingMsg"></p>
</div>

<div class="container" id="admin">
<h2>Admin Dashboard</h2>
<input id="newDestination" placeholder="Tourism Destination">
<button onclick="addDestination()">Post Tourism Details</button>
<div id="destinationList"></div>
<h3>Booking Details</h3>
<div id="bookings"></div>
</div>

<script>
let bookingList=[];
function showFood(){
foodMsg.innerText="Available: "+food.value;
}
function showHotel(){
hotelMsg.innerText="Available accommodation: "+hotel.value;
}
function showRoute(){
routeMsg.innerText="Selected route: "+route.value;
}
function book(){
if(!customer.value||!date.value){
alert("Enter name and travel date");return;
}
bookingList.push(customer.value+" - "+room.value+" - "+date.value);
bookingMsg.innerText="Booking successful!";
displayBookings();
}
function displayBookings(){
bookings.innerHTML="";
bookingList.forEach(b=>bookings.innerHTML+="<p>"+b+"</p>");
}
function addDestination(){
if(!newDestination.value){alert("Enter destination");return;}
destinationList.innerHTML+="<p>"+newDestination.value+"</p>";
newDestination.value="";
}
</script>
</body>
</html>
