
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>LibraSpace | College Library</title>
<style>
:root {
  --primary: #4f46e5;
  --primary-light: #eef2ff;
  --bg: #f6f7fb;
  --text: #20243a;
  --muted: #858ba3;
  --border: #e9eaf2;
  --white: #ffffff;
  --green: #16a36a;
  --red: #e05260;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body {
  font-family: Inter, "Segoe UI", Arial, sans-serif;
  background: var(--bg);
  color: var(--text);
  font-size: 14px;
}
button, input, select { font: inherit; }
button { cursor: pointer; }
.app { display: flex; min-height: 100vh; }
.sidebar {
  width: 245px; background: var(--white); border-right: 1px solid var(--border);
  padding: 26px 17px; display: flex; flex-direction: column; flex-shrink: 0;
}
.brand { display: flex; align-items: center; gap: 11px; padding: 0 10px 32px; }
.brand-icon {
  background: var(--primary); color: white; border-radius: 12px;
  width: 42px; height: 42px; display: grid; place-items: center; font-size: 23px;
}
.brand h2 { font-size: 20px; letter-spacing: -0.7px; }
.brand p { font-size: 11px; color: var(--muted); margin-top: 4px; }
.nav-label { color: #a2a6b7; font-size: 10px; font-weight: 800; letter-spacing: 1.3px; padding: 16px 12px 10px; }
.nav-btn {
  border: 0; background: transparent; width: 100%; padding: 12px;
  display: flex; align-items: center; gap: 12px; border-radius: 9px;
  color: #6f748c; text-align: left; margin-bottom: 4px; transition: .2s;
}
.nav-btn:hover, .nav-btn.active { background: var(--primary-light); color: var(--primary); }
.nav-btn.active { font-weight: 700; }
.nav-icon { width: 20px; text-align: center; font-size: 17px; }
.sidebar-bottom { margin-top: auto; }
.help-card { background: #f7f7ff; padding: 17px; border-radius: 13px; margin: 22px 0; }
.help-card strong { display: block; margin: 9px 0 5px; }
.help-card p { color: var(--muted); font-size: 12px; line-height: 1.6; }
.help-card button { border: 0; color: var(--primary); background: transparent; margin-top: 10px; font-weight: 700; }
.main { flex: 1; min-width: 0; }
.topbar {
  height: 83px; background: white; border-bottom: 1px solid var(--border);
  display: flex; justify-content: space-between; align-items: center;
  padding: 0 35px; gap: 15px;
}
.page-title { font-size: 21px; font-weight: 750; }
.page-subtitle { color: var(--muted); margin-top: 5px; font-size: 12px; }
.top-actions { display: flex; align-items: center; gap: 13px; }
.role-select, .search-input, .field {
  background: white; border: 1px solid var(--border); border-radius: 9px;
  padding: 10px 12px; outline: none; color: var(--text);
}
.role-select:focus, .search-input:focus, .field:focus { border-color: var(--primary); }
.avatar {
  width: 39px; height: 39px; border-radius: 12px; display: grid; place-items: center;
  background: #e8e9ff; color: var(--primary); font-weight: 800;
}
.content { padding: 30px 35px 45px; max-width: 1600px; margin: auto; }
.welcome {
  padding: 27px 30px; border-radius: 17px; color: white;
  background: linear-gradient(115deg, #4f46e5, #7773f7);
  display: flex; justify-content: space-between; align-items: center; gap: 20px;
  position: relative; overflow: hidden;
}
.welcome h1 { font-size: clamp(22px, 3vw, 30px); letter-spacing: -.8px; }
.welcome p { color: #e3e3ff; margin-top: 10px; line-height: 1.7; }
.welcome .art { font-size: 74px; opacity: .9; padding-right: 20px; }
.btn {
  border: 0; background: var(--primary); color: white; border-radius: 8px;
  padding: 10px 15px; font-weight: 650; transition: .2s;
}
.btn:hover { filter: brightness(.93); transform: translateY(-1px); }
.btn-light { background: white; color: var(--primary); margin-top: 17px; }
.btn-outline { background: white; color: var(--text); border: 1px solid var(--border); }
.btn-danger { background: #fff0f1; color: var(--red); }
.btn-green { background: #e8f8f0; color: var(--green); }
.stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 17px; margin: 23px 0 29px; }
.stat {
  background: white; padding: 20px; border: 1px solid var(--border); border-radius: 13px;
  min-width: 0;
}
.stat-top { display: flex; justify-content: space-between; align-items: center; gap: 6px; }
.stat-label { color: var(--muted); font-size: 12px; }
.stat-icon { width: 37px; height: 37px; border-radius: 11px; display: grid; place-items: center; font-size: 19px; }
.purple { background: #efedff; } .blue { background: #e9f5ff; }
.orange { background: #fff2e5; } .mint { background: #e5f8ef; }
.stat h2 { font-size: 27px; margin: 15px 0 8px; letter-spacing: -.7px; }
.stat small { color: var(--muted); font-size: 11px; }
.green-text { color: var(--green); }
.section-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin: 27px 0 16px; }
.section-head h2 { font-size: 17px; }
.section-head p { color: var(--muted); margin-top: 5px; font-size: 12px; }
.grid-2 { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(250px, 1fr); gap: 20px; }
.panel { background: white; border: 1px solid var(--border); border-radius: 13px; padding: 21px; min-width: 0; }
.panel h3 { font-size: 15px; }
.panel-desc { color: var(--muted); font-size: 12px; margin-top: 6px; }
.book-list { display: grid; gap: 0; }
.book-row { display: flex; gap: 13px; align-items: center; padding: 15px 0; border-bottom: 1px solid #f0f0f5; min-width: 0; }
.book-row:last-child { border-bottom: 0; }
.cover {
  width: 47px; height: 58px; flex-shrink: 0; border-radius: 6px; display: grid;
  place-items: center; font-size: 24px; background: #e8e9ff;
}
.cover.c2 { background: #ffe9d7; } .cover.c3 { background: #dcf5eb; }
.cover.c4 { background: #fbe2ec; } .cover.c5 { background: #e0efff; }
.book-info { flex: 1; min-width: 0; }
.book-info strong { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.book-info p { color: var(--muted); font-size: 12px; margin-top: 6px; }
.pill { display: inline-block; border-radius: 20px; padding: 5px 9px; font-size: 10px; font-weight: 750; white-space: nowrap; }
.available { background: #e4f7ed; color: #138553; }
.issued { background: #fff1dc; color: #b66b0b; }
.overdue { background: #ffebed; color: #cf3549; }
.quick-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 18px; }
.quick {
  padding: 17px 12px; border: 1px solid var(--border); border-radius: 11px;
  background: white; text-align: left; color: var(--text);
}
.quick:hover { border-color: var(--primary); background: #fafaff; }
.quick span { font-size: 23px; display: block; margin-bottom: 12px; }
.quick strong { font-size: 12px; }
.quick p { color: var(--muted); font-size: 11px; margin-top: 6px; line-height: 1.5; }
.page { display: none; }
.page.active { display: block; }
.toolbar { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 18px; }
.toolbar .search-input { flex: 1; min-width: 180px; }
.table-wrap { overflow-x: auto; background: white; border: 1px solid var(--border); border-radius: 12px; }
table { width: 100%; border-collapse: collapse; text-align: left; white-space: nowrap; }
th { color: var(--muted); background: #fafbfe; font-size: 11px; font-weight: 700; }
th, td { padding: 15px 17px; border-bottom: 1px solid #f0f0f5; }
td { font-size: 12px; }
tbody tr:last-child td { border-bottom: 0; }
td strong { font-size: 12px; }
.actions { display: flex; gap: 7px; align-items: center; }
.small-btn { border: 0; padding: 7px 9px; border-radius: 6px; font-size: 11px; font-weight: 700; }
.material-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 17px; }
.material-card { background: white; border: 1px solid var(--border); border-radius: 13px; padding: 19px; }
.material-icon { font-size: 30px; margin-bottom: 17px; }
.material-card h3 { font-size: 14px; }
.material-card p { color: var(--muted); font-size: 12px; line-height: 1.7; margin: 9px 0 15px; }
.material-meta { display: flex; gap: 7px; flex-wrap: wrap; margin-bottom: 15px; }
.material-meta span { background: #f2f3f9; padding: 5px 8px; border-radius: 5px; font-size: 10px; }
.material-card .btn { width: 100%; }
.empty { text-align: center; padding: 35px; color: var(--muted); }
.profile-box { max-width: 600px; }
.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 17px; margin-top: 20px; }
.form-group label { display: block; font-size: 12px; font-weight: 700; margin-bottom: 8px; }
.form-group input, .form-group select { width: 100%; }
.form-group.full { grid-column: 1 / -1; }
.note { padding: 14px; background: #f2f2ff; border-radius: 9px; color: #5b58a8; font-size: 12px; line-height: 1.7; margin-bottom: 17px; }
.footer { color: #a2a6b7; font-size: 11px; text-align: center; padding-top: 32px; }
.toast {
  position: fixed; bottom: 25px; right: 25px; background: #24253b; color: white;
  padding: 14px 20px; border-radius: 10px; box-shadow: 0 8px 30px #0002;
  opacity: 0; transform: translateY(12px); pointer-events: none; transition: .25s; z-index: 20;
}
.toast.show { opacity: 1; transform: translateY(0); }
.modal-backdrop {
  display: none; position: fixed; inset: 0; z-index: 30; background: #15152c88;
  align-items: center; justify-content: center; padding: 20px;
}
.modal-backdrop.open { display: flex; }
.modal { width: 100%; max-width: 440px; background: white; padding: 25px; border-radius: 15px; }
.modal-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
.close-btn { background: #f2f3f8; border: 0; border-radius: 8px; width: 32px; height: 32px; }
.modal .form-group { margin-bottom: 15px; }
.modal .btn { width: 100%; margin-top: 5px; }
.mobile-menu { display: none; }
@media(max-width:1050px) {
  .sidebar { width: 210px; }
  .content { padding: 25px 22px; }
  .topbar { padding: 0 22px; }
  .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .material-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media(max-width:720px) {
  .sidebar { display: none; position: fixed; inset: 0 auto 0 0; z-index: 15; width: 250px; box-shadow: 10px 0 40px #0002; }
  .sidebar.mobile-open { display: flex; }
  .mobile-menu { display: inline-block; border: 0; background: white; font-size: 22px; margin-right: 10px; }
  .topbar { height: 72px; padding: 0 15px; }
  .content { padding: 18px 14px; }
  .welcome { padding: 23px 20px; }
  .welcome .art { display: none; }
  .grid-2 { grid-template-columns: 1fr; }
  .material-grid { grid-template-columns: 1fr; }
  .page-title { font-size: 17px; }
  .role-select { max-width: 120px; padding: 9px 5px; }
  .top-actions { gap: 7px; }
  .stats { gap: 10px; }
  .stat { padding: 14px; }
  .stat h2 { font-size: 23px; }
  .form-grid { grid-template-columns: 1fr; }
  .form-group.full { grid-column: auto; }
}
@media(max-width:390px) {
  .stats { grid-template-columns: 1fr 1fr; }
  .stat-label { font-size: 11px; }
  .welcome h1 { font-size: 22px; }
  .avatar { width: 33px; height: 33px; }
}

/* LOGIN AND REGISTRATION */
.auth-screen {
  min-height: 100vh;
  display: grid;
  grid-template-columns: 1fr 1fr;
  background: white;
}
.auth-left {
  background: linear-gradient(145deg, #3730a3, #6366f1, #818cf8);
  color: white;
  padding: 60px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.auth-left h1 { font-size: clamp(30px, 4vw, 48px); line-height: 1.2; margin: 25px 0 15px; }
.auth-left p { color: #e4e4ff; line-height: 1.8; max-width: 420px; }
.auth-art { font-size: 85px; margin-top: 30px; }
.auth-right { display: grid; place-items: center; padding: 35px 22px; }
.auth-form { width: 100%; max-width: 390px; }
.auth-form h2 { font-size: 29px; margin-bottom: 10px; }
.auth-form > p { color: #858ba3; margin-bottom: 25px; line-height: 1.6; }
.auth-form .form-group { margin-bottom: 17px; }
.auth-form .field { width: 100%; margin-top: 8px; }
.auth-form .btn { width: 100%; margin-top: 10px; padding: 13px; }
.auth-switch { color: #858ba3; text-align: center; margin-top: 22px; }
.auth-switch button { border: 0; background: transparent; color: #4f46e5; font-weight: 700; }
.auth-error { color: #cf3549; font-size: 12px; margin: 12px 0; }
.demo-info { background: #f2f2ff; border-radius: 9px; padding: 13px; margin-top: 20px; font-size: 12px; line-height: 1.9; color: #5149a8; }
.auth-brand { font-size: 22px; font-weight: 800; }
.auth-brand span { color: #c7d2fe; }
@media(max-width:700px) {
  .auth-screen { grid-template-columns: 1fr; }
  .auth-left { padding: 27px; min-height: 220px; }
  .auth-left h1 { font-size: 28px; margin: 15px 0 8px; }
  .auth-art { display: none; }
  .auth-right { padding: 35px 22px; }
}

/* Registration success message */
.auth-success {
  color: #15803d;
  font-size: 24px;
  font-weight: 700;
  line-height: 1.5;
  margin: 16px 0;
}

/* Login and registration errors remain red */
.auth-error {
  color: #dc2626;
  font-size: 13px;
  font-weight: 500;
  margin: 12px 0;
}

</style>
</head>
<body>

<div class="auth-screen" id="authScreen">
  <div class="auth-left">
    <div class="auth-brand">▤ Libra<span>Space</span></div>
    <h1>Your campus.<br>Your library.<br>Your knowledge.</h1>
    <p>Sign in to explore books, access semester-wise study materials, manage borrowing history, and keep track of library fines.</p>
    <div class="auth-art">📚 🎓</div>
  </div>

  <div class="auth-right">
    <form class="auth-form" id="loginForm" onsubmit="loginUser(event)">
      <h2>Welcome back!</h2>
      <p>Sign in to your college library account.</p>

      <div class="form-group">
        <label for="loginEmail">Email address</label>
        <input class="field" id="loginEmail" type="email"
          placeholder="Enter your email" required>
      </div>

      <div class="form-group">
        <label for="loginPassword">Password</label>
        <input class="field" id="loginPassword" type="password"
          placeholder="Enter your password" required>
      </div>

      <div id="loginError" class="auth-error" role="alert"></div>
      <button class="btn" type="submit">Sign in →</button>

      <div class="auth-switch">
        Don't have an account?
        <button type="button" onclick="showAuthForm('register')">Register</button>
      </div>

      <div class="demo-info">
        <strong>Demo student:</strong><br>
        student@library.com / student123<br>
        <strong>Demo librarian:</strong><br>
        admin@library.com / admin123
      </div>
    </form>

    <form class="auth-form" id="registerForm"
      onsubmit="registerUser(event)" style="display:none">
      <h2>Create account</h2>
      <p>Register to access your college library.</p>

      <div class="form-group">
        <label for="registerName">Full name</label>
        <input class="field" id="registerName" required
          placeholder="Enter your full name">
      </div>

      <div class="form-group">
        <label for="registerEmail">College email</label>
        <input class="field" id="registerEmail" type="email"
          required placeholder="Enter your email">
      </div>

      <div class="form-group">
        <label for="registerId">Student ID</label>
        <input class="field" id="registerId" required
          placeholder="Enter your student ID">
      </div>

      <div class="form-group">
        <label for="registerPassword">Create password</label>
        <input class="field" id="registerPassword" type="password"
          minlength="6" required placeholder="Minimum 6 characters">
      </div>

      <div id="registerError" class="auth-error" role="alert"></div>
      <button class="btn" type="submit">Create account →</button>

      <div class="auth-switch">
        Already registered?
        <button type="button" onclick="showAuthForm('login')">Sign in</button>
      </div>
    </form>
  </div>
</div>
<div class="app" id="appRoot" style="display:none">
  <aside class="sidebar" id="sidebar">
    <div class="brand">
      <div class="brand-icon">▤</div>
      <div><h2>LibraSpace</h2><p>COLLEGE LIBRARY PORTAL</p></div>
    </div>
    <div class="nav-label">WORKSPACE</div>
    <button class="nav-btn active" data-page="dashboard"><span class="nav-icon">▦</span> Dashboard</button>
    <button class="nav-btn" data-page="books"><span class="nav-icon">▤</span> Book Catalog</button>
    <button class="nav-btn" data-page="materials"><span class="nav-icon">▧</span> Study Materials</button>
    <button class="nav-btn" data-page="loans"><span class="nav-icon">↔</span> My Borrow History</button>
    <button class="nav-btn" data-page="fines"><span class="nav-icon">₹</span> Fines & Payments</button>
    <div class="nav-label admin-nav">ADMINISTRATION</div>
    <button class="nav-btn admin-nav" data-page="manage"><span class="nav-icon">⚙</span> Manage Library</button>
    <button class="nav-btn" data-page="profile"><span class="nav-icon">♙</span> My Profile</button>
    <div class="sidebar-bottom">
      <div class="help-card">
        <span style="font-size:24px">💡</span>
        <strong>Need assistance?</strong>
        <p>Have questions about borrowing books or accessing resources?</p>
        <button onclick="openContact()">Contact librarian ↗</button>
      </div>

<button class="nav-btn" onclick="logoutUser()">
  <span class="nav-icon">⇥</span> Sign out
</button>

    </div>
  </aside>

  <main class="main">
    <header class="topbar">
      <div style="display:flex;align-items:center;min-width:0">
        <button class="mobile-menu" onclick="toggleSidebar()" aria-label="Open menu">☰</button>
        <div>
          <div class="page-title" id="topTitle">Dashboard</div>
          <div class="page-subtitle">Your campus learning space</div>
        </div>
      </div>
      <div class="top-actions">
        <select class="role-select" id="roleSelect" aria-label="Demo role" onchange="changeRole()">
          <option value="student">Student View</option>
          <option value="admin">Librarian Admin</option>
        </select>
        <div class="avatar" id="topAvatar">SL</div>
      </div>
    </header>

    <div class="content">
      <section class="page active" id="dashboard">
        <div class="welcome">
          <div>
            <div style="font-size:11px;letter-spacing:1.4px;color:#dedcff;font-weight:800;margin-bottom:12px">YOUR KNOWLEDGE HUB</div>
            <h1 id="welcomeTitle">Welcome back, Sai Lahari! 👋</h1>
            <p>Discover books, access study materials, and stay on top of your learning journey.</p>
            <button class="btn btn-light" onclick="navigate('books')">Explore book catalog →</button>
          </div>
          <div class="art">📚</div>
        </div>
        <div class="stats">
          <div class="stat"><div class="stat-top"><span class="stat-label">Total Books</span><span class="stat-icon purple">📚</span></div><h2 id="totalBooks">1,248</h2><small>Books in the catalog</small></div>
          <div class="stat"><div class="stat-top"><span class="stat-label">Available Books</span><span class="stat-icon mint">✓</span></div><h2 id="availableBooks">0</h2><small>Ready to borrow</small></div>
          <div class="stat"><div class="stat-top"><span class="stat-label">My Borrowed Books</span><span class="stat-icon blue">↗</span></div><h2 id="myBorrowed">0</h2><small>Currently on loan</small></div>
          <div class="stat"><div class="stat-top"><span class="stat-label">Outstanding Fine</span><span class="stat-icon orange">₹</span></div><h2 id="myFine">₹0</h2><small>Pending library dues</small></div>
        </div>
        <div class="grid-2">
          <div>
            <div class="section-head"><div><h2>Recently added books</h2><p>Explore popular learning resources</p></div><button class="btn btn-outline" onclick="navigate('books')">View all</button></div>
            <div class="panel"><div class="book-list" id="recentBooks"></div></div>
          </div>
          <div>
            <div class="section-head"><div><h2>Quick actions</h2><p>Everything you need, in one place</p></div></div>
            <div class="panel">
              <h3>What would you like to do?</h3>
              <p class="panel-desc">Access your library services quickly.</p>
              <div class="quick-actions">
                <button class="quick" onclick="navigate('books')"><span>🔍</span><strong>Find a book</strong><p>Search the catalog</p></button>
                <button class="quick" onclick="navigate('materials')"><span>📂</span><strong>Study materials</strong><p>Notes and resources</p></button>
                <button class="quick" onclick="navigate('loans')"><span>📖</span><strong>Borrow history</strong><p>Check due dates</p></button>
                <button class="quick" onclick="navigate('fines')"><span>🧾</span><strong>Check fines</strong><p>Review library dues</p></button>
              </div>
            </div>
          </div>
        </div>
        <div class="footer">LibraSpace · Smart Library Management System · Learn without limits.</div>
      </section>

      <section class="page" id="books">
        <div class="section-head"><div><h2>Book Catalog</h2><p>Search books by title, author, category, or ISBN.</p></div></div>
        <div class="toolbar">
          <input id="bookSearch" class="search-input" placeholder="🔍  Search books, authors, ISBN..." oninput="renderBooks()">
          <select id="categoryFilter" class="field" onchange="renderBooks()">
            <option value="">All categories</option><option>Computer Science</option><option>Artificial Intelligence</option><option>Mathematics</option><option>Database</option><option>Literature</option>
          </select>
          <button class="btn admin-only" onclick="openBookModal()">+ Add book</button>
        </div>
        <div class="table-wrap"><table><thead><tr><th>BOOK DETAILS</th><th>ISBN</th><th>CATEGORY</th><th>AVAILABILITY</th><th>ACTION</th></tr></thead><tbody id="bookTable"></tbody></table></div>
      </section>

      <section class="page" id="materials">
        <div class="section-head"><div><h2>Study Materials</h2><p>Access notes, lecture slides, and academic resources by year and semester.</p></div><button class="btn admin-only" onclick="openMaterialModal()">+ Add material</button></div>
        <div class="toolbar">
          <input class="search-input" id="materialSearch" placeholder="🔍  Search learning resources..." oninput="renderMaterials()">
