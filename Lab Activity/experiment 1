function initializeProfile() {
 $("profileName").value=currentUser.name;$("profileId").value=currentUser.id;
 $("profileEmail").value=currentUser.email;$("profileDept").value=currentUser.dept;$("profileYear").value=currentUser.year;
 $("profileNameHeading").textContent=currentUser.name;
}

const DEMO_USERS = [
  {
    name: "Sai Lahari",
    email: "student@library.com",
    password: "student123",
    id: "STU2026001",
    dept: "Artificial Intelligence & ML",
    year: "4th Year",
    role: "student"
  },
  {
    name: "Library Admin",
    email: "admin@library.com",
    password: "admin123",
    id: "LIB001",
    dept: "Library Administration",
    year: "Staff",
    role: "admin"
  }
];

function getRegisteredUsers() {
  try {
    return JSON.parse(localStorage.getItem("libraUsers") || "[]");
  } catch {
    return [];
  }
}

function showAuthForm(type) {
  $("loginForm").style.display = type === "login" ? "block" : "none";
  $("registerForm").style.display = type === "register" ? "block" : "none";
  $("loginError").textContent = "";
  $("registerError").textContent = "";
}

function loginUser(event) {
  event.preventDefault();

  const email = $("loginEmail").value.trim().toLowerCase();
  const password = $("loginPassword").value;

  const users = [...DEMO_USERS, ...getRegisteredUsers()];
  const user = users.find(u =>
    u.email.toLowerCase() === email && u.password === password
  );

  if (!user) {
    $("loginError").textContent =
      "Invalid email or password. Please try again.";
    return;
  }

  currentUser = {
    name: user.name,
    id: user.id,
    email: user.email,
    dept: user.dept || "Artificial Intelligence & ML",
    year: user.year || "1st Year"
  };

  role = user.role;
  $("roleSelect").value = role;
  $("authScreen").style.display = "none";
  $("appRoot").style.display = "flex";

  initializeProfile();
  changeRole();
  navigate("dashboard");

  showToast("Welcome, " + currentUser.name + "!");
}

function registerUser(event) {
  event.preventDefault();

  const name = $("registerName").value.trim();
  const email = $("registerEmail").value.trim().toLowerCase();
  const id = $("registerId").value.trim();
  const password = $("registerPassword").value;

  const users = getRegisteredUsers();

  const duplicate = [...DEMO_USERS, ...users].some(u =>
    u.email.toLowerCase() === email ||
    u.id.toLowerCase() === id.toLowerCase()
  );

  if (duplicate) {
    $("registerError").textContent =
      "This email or student ID is already registered.";
    return;
  }

  const newUser = {
    name,
    email,
    id,
    password,
    role: "student",
    dept: "Artificial Intelligence & ML",
    year: "1st Year"
  };

  try {
    users.push(newUser);
    localStorage.setItem("libraUsers", JSON.stringify(users));
  } catch {
    $("registerError").textContent =
      "Unable to save account in this browser.";
    return;
  }

  $("loginEmail").value = email;
  $("loginPassword").value = "";
  showAuthForm("login");
  $("loginError").textContent =
    "Registration successful! Please sign in.";
}

function logoutUser() {
  $("appRoot").style.display = "none";
  $("authScreen").style.display = "grid";

  $("loginForm").reset();
  $("registerForm").reset();

  $("roleSelect").value = "student";
  role = "student";

  showAuthForm("login");
  showToast("You have successfully signed out.");
}

</script>
