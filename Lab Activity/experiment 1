          <div class="note">This demo stores changes in your current browser session. A production system should use secure server-side accounts.</div>
          <form id="profileForm" onsubmit="saveProfile(event)">
            <div class="form-grid">
              <div class="form-group"><label>Full name</label><input class="field" id="profileName" required></div>
              <div class="form-group"><label>Student ID</label><input class="field" id="profileId" value="STU2026001"></div>
              <div class="form-group"><label>Email address</label><input class="field" id="profileEmail" type="email" required></div>
              <div class="form-group"><label>Department</label><select class="field" id="profileDept"><option>Artificial Intelligence & ML</option><option>Computer Science</option><option>Electronics</option><option>Information Technology</option></select></div>
