<div class="modal-backdrop" id="modalBackdrop" onclick="if(event.target===this)closeModal()">
  <div class="modal">
    <div class="modal-head"><h2 id="modalTitle">Add book</h2><button class="close-btn" onclick="closeModal()">✕</button></div>
    <form id="modalForm"><div id="modalFields"></div><button class="btn" id="modalSubmit">Save</button></form>
  </div>
</div>
<div class="toast" id="toast" role="status"></div>

<script>
const $ = id => document.getElementById(id);
const today = new Date();
const dateOffset = days => {
  const d = new Date();
  d.setDate(d.getDate() + days);
  return d.toISOString().slice(0,10);
};
let role = "student";
let currentUser = {name:"Sai Lahari", id:"STU2026001", email:"lahari@example.com",
  dept:"Artificial Intelligence & ML", year:"4th Year"};

let books = [
 {id:1,title:"Introduction to Algorithms",author:"Thomas H. Cormen",isbn:"9780262046305",category:"Computer Science",total:5,available:3,icon:"📘"},
 {id:2,title:"Artificial Intelligence: A Modern Approach",author:"Stuart Russell",isbn:"9780134610993",category:"Artificial Intelligence",total:4,available:2,icon:"🤖"},
 {id:3,title:"Database System Concepts",author:"Abraham Silberschatz",isbn:"9780078022159",category:"Database",total:6,available:4,icon:"🗄️"},
 {id:4,title:"Clean Code",author:"Robert C. Martin",isbn:"9780132350884",category:"Computer Science",total:3,available:1,icon:"📗"},
 {id:5,title:"Discrete Mathematics",author:"Kenneth Rosen",isbn:"9781259676512",category:"Mathematics",total:4,available:4,icon:"📙"},
 {id:6,title:"The Alchemist",author:"Paulo Coelho",isbn:"9780062315007",category:"Literature",total:3,available:3,icon:"📕"}
];
let loans = [
 {id:1,bookId:1,student:"Sai Lahari",studentId:"STU2026001",issue:dateOffset(-12),due:dateOffset(-5),returned:false},
 {id:2,bookId:3,student:"Sai Lahari",studentId:"STU2026001",issue:dateOffset(-4),due:dateOffset(10),returned:false},
 {id:3,bookId:4,student:"Sai Lahari",studentId:"STU2026001",issue:dateOffset(-20),due:dateOffset(-13),returned:true}
];
let materials = [
 {id:1,title:"Data Structures & Algorithms",desc:"Lecture notes, algorithm examples, and practice problems.",year:"2nd Year",semester:"Semester 1",subject:"Computer Science",icon:"📘"},
 {id:2,title:"Machine Learning Fundamentals",desc:"Model concepts, supervised learning, and revision notes.",year:"3rd Year",semester:"Semester 1",subject:"Artificial Intelligence",icon:"🤖"},
 {id:3,title:"Database Management Systems",desc:"SQL queries, normalization, and relational database notes.",year:"2nd Year",semester:"Semester 2",subject:"Database",icon:"🗄️"},
 {id:4,title:"Data Visualization with R",desc:"Charts, plotting methods, and visualization lab notes.",year:"3rd Year",semester:"Semester 2",subject:"Data Analytics",icon:"📊"},
 {id:5,title:"Python Programming",desc:"Python syntax, functions, and hands-on exercises.",year:"1st Year",semester:"Semester 1",subject:"Programming",icon:"🐍"},
 {id:6,title:"Artificial Intelligence Notes",desc:"Search methods, knowledge representation, and AI concepts.",year:"4th Year",semester:"Semester 1",subject:"Artificial Intelligence",icon:"🧠"}
];
let nextBookId = 7, nextMaterialId = 7, nextLoanId = 4, editingBookId = null;

function escapeHTML(s) {
 return String(s ?? "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
}
function formatDate(d) {
 if(!d) return "—";
 return new Date(d+"T00:00:00").toLocaleDateString("en-IN",{day:"2-digit",month:"short",year:"numeric"});
}
function fineFor(loan) {
 if(loan.returned) return 0;
 const days = Math.max(0, Math.floor((new Date(dateOffset(0)+"T00:00:00") - new Date(loan.due+"T00:00:00")) / 86400000));
 return days * 5;
}
function daysLate(loan) { return Math.floor(fineFor(loan)/5); }
function activeLoans() { return loans.filter(l=>!l.returned); }
function userLoans() { return loans.filter(l=>role==="admin" || l.studentId===currentUser.id); }
function bookById(id) { return books.find(b=>b.id===id); }
function showToast(message) {
 const t=$("toast"); t.textContent=message; t.classList.add("show");
 clearTimeout(showToast.timer); showToast.timer=setTimeout(()=>t.classList.remove("show"),2800);
}
function navigate(page) {
 document.querySelectorAll(".page").forEach(p=>p.classList.remove("active"));
 $(page).classList.add("active");
 document.querySelectorAll(".nav-btn[data-page]").forEach(b=>b.classList.toggle("active",b.dataset.page===page));
 const titles={dashboard:"Dashboard",books:"Book Catalog",materials:"Study Materials",loans:"My Borrow History",fines:"Fines & Payments",manage:"Library Administration",profile:"My Profile"};
 $("topTitle").textContent=titles[page]||"Library";
 $("sidebar").classList.remove("mobile-open");
 renderAll();
}
document.querySelectorAll(".nav-btn[data-page]").forEach(b=>b.addEventListener("click",()=>navigate(b.dataset.page)));
function toggleSidebar() { $("sidebar").classList.toggle("mobile-open"); }
function changeRole() {
 role=$("roleSelect").value;
 document.querySelectorAll(".admin-nav,.admin-only").forEach(el=>el.style.display=role==="admin"?(el.classList.contains("nav-btn")?"flex":"inline-block"):"none");
 $("welcomeTitle").textContent=role==="admin"?"Welcome, Librarian! 👋":`Welcome back, ${currentUser.name}! 👋`;
 $("topAvatar").textContent=role==="admin"?"LA":currentUser.name.split(" ").map(x=>x[0]).join("").slice(0,2).toUpperCase();
 renderAll();
 showToast(role==="admin"?"Librarian demo view enabled":"Student view enabled");
}
function renderDashboard() {
 const mine=userLoans(), active=mine.filter(l=>!l.returned);
 $("totalBooks").textContent=books.reduce((s,b)=>s+b.total,0).toLocaleString("en-IN");
 $("availableBooks").textContent=books.reduce((s,b)=>s+b.available,0);
 $("myBorrowed").textContent=active.length;
 $("myFine").textContent="₹"+mine.reduce((s,l)=>s+fineFor(l),0);
 $("recentBooks").innerHTML=books.slice(0,4).map((b,i)=>`
 <div class="book-row"><div class="cover c${i+1}">${b.icon}</div><div class="book-info"><strong>${escapeHTML(b.title)}</strong><p>${escapeHTML(b.author)}</p></div><span class="pill ${b.available?"available":"issued"}">${b.available?"Available":"Issued"}</span></div>`).join("");
}
function renderBooks() {
 const q=($("bookSearch")?.value||"").toLowerCase(), cat=$("categoryFilter")?.value||"";
 const rows=books.filter(b=>(`${b.title} ${b.author} ${b.isbn} ${b.category}`.toLowerCase().includes(q))&&(!cat||b.category===cat));
 $("bookTable").innerHTML=rows.length?rows.map(b=>`<tr>
 <td><strong>${escapeHTML(b.title)}</strong><div style="color:var(--muted);margin-top:5px">${escapeHTML(b.author)}</div></td>
 <td>${escapeHTML(b.isbn)}</td><td>${escapeHTML(b.category)}</td>
 <td><span class="pill ${b.available?"available":"issued"}">${b.available?b.available+" available":"Unavailable"}</span></td>
 <td>${role==="admin"?`<button class="small-btn" style="background:#efedff;color:#4f46e5" onclick="issueBook(${b.id})">Issue</button> <button class="small-btn btn-outline" onclick="editBook(${b.id})">Edit</button>`:b.available?`<button class="small-btn" style="background:#efedff;color:#4f46e5" onclick="requestBook(${b.id})">Request</button>`:"—"}</td>
 </tr>`).join(""):`<tr><td colspan="5" class="empty">No books found. Try a different search.</td></tr>`;
}
function renderMaterials() {
 const q=($("materialSearch")?.value||"").toLowerCase(), y=$("yearFilter")?.value||"", s=$("semesterFilter")?.value||"";
 const list=materials.filter(m=>(`${m.title} ${m.subject} ${m.desc}`.toLowerCase().includes(q))&&(!y||m.year===y)&&(!s||m.semester===s));
 $("materialGrid").innerHTML=list.length?list.map(m=>`<div class="material-card">
 <div class="material-icon">${m.icon}</div><h3>${escapeHTML(m.title)}</h3><p>${escapeHTML(m.desc)}</p>
 <div class="material-meta"><span>${escapeHTML(m.year)}</span><span>${escapeHTML(m.semester)}</span><span>${escapeHTML(m.subject)}</span></div>
 <button class="btn" onclick="downloadMaterial(${m.id})">↓ Download resource</button>
 ${role==="admin"?`<button class="btn btn-outline" style="margin-top:8px" onclick="deleteMaterial(${m.id})">Delete resource</button>`:""}
 </div>`).join(""):`<div class="panel empty">No materials match your filters.</div>`;
}
function renderLoans() {
 const list=userLoans();
 $("loanTable").innerHTML=list.length?list.map(l=>{
 const b=bookById(l.bookId); if(!b)return "";
 const f=fineFor(l);
 return `<tr><td><strong>${escapeHTML(b.title)}</strong></td><td>${formatDate(l.issue)}</td><td>${formatDate(l.due)}</td>
 <td><span class="pill ${l.returned?"available":f?"overdue":"issued"}">${l.returned?"Returned":f?"Overdue":"Issued"}</span></td>
 <td>₹${f}</td><td>${role==="admin"&&!l.returned?`<button class="small-btn btn-green" onclick="returnBook(${l.id})">Return</button>`:"—"}</td></tr>`;
 }).join(""):`<tr><td colspan="6" class="empty">No borrowing records yet. Visit the catalog to find a book.</td></tr>`;
 const due=userLoans().filter(l=>!l.returned&&fineFor(l)>0);
 $("fineTotal").textContent="₹"+userLoans().reduce((s,l)=>s+fineFor(l),0);
 $("overdueCount").textContent=due.length;
 $("fineTable").innerHTML=userLoans().length?userLoans().map(l=>{
 const b=bookById(l.bookId);if(!b)return "";
 const d=daysLate(l),f=fineFor(l);
 return `<tr><td>${escapeHTML(b.title)}</td><td>${formatDate(l.due)}</td><td>${d}</td><td>₹${f}</td><td><span class="pill ${f?"overdue":"available"}">${f?"Pending":"No fine"}</span></td></tr>`;
 }).join(""):`<tr><td colspan="5" class="empty">No fines or borrowing records.</td></tr>`;
 $("adminLoanTable").innerHTML=loans.length?loans.map(l=>`<tr><td>${escapeHTML(l.student)}</td><td>${escapeHTML(bookById(l.bookId)?.title||"Deleted book")}</td><td>${formatDate(l.due)}</td><td><span class="pill ${l.returned?"available":fineFor(l)?"overdue":"issued"}">${l.returned?"Returned":fineFor(l)?"Overdue":"Issued"}</span></td><td>${l.returned?"—":`<button class="small-btn btn-green" onclick="returnBook(${l.id})">Return</button>`}</td></tr>`).join(""):`<tr><td colspan="5" class="empty">No lending records.</td></tr>`;
}
function renderAdmin() {
 const q=($("adminSearch")?.value||"").toLowerCase(), list=books.filter(b=>`${b.title} ${b.author}`.toLowerCase().includes(q));
 $("adminTitles").textContent=books.length;
 $("adminAvailable").textContent=books.reduce((s,b)=>s+b.available,0);
 $("adminLoans").textContent=activeLoans().length;
 $("adminFine").textContent="₹"+loans.reduce((s,l)=>s+fineFor(l),0);
 $("adminTable").innerHTML=list.length?list.map(b=>`<tr><td><strong>${escapeHTML(b.title)}</strong><div style="color:var(--muted);margin-top:5px">${escapeHTML(b.isbn)}</div></td><td>${escapeHTML(b.author)}</td><td>${b.total}</td><td>${b.available}</td><td><div class="actions"><button class="small-btn" style="background:#efedff;color:#4f46e5" onclick="issueBook(${b.id})">Issue</button><button class="small-btn btn-outline" onclick="editBook(${b.id})">Edit</button><button class="small-btn btn-danger" onclick="deleteBook(${b.id})">Delete</button></div></td></tr>`).join(""):`<tr><td colspan="5" class="empty">No books found.</td></tr>`;
}
function renderAll() { renderDashboard();renderBooks();renderMaterials();renderLoans();renderAdmin(); }
function requestBook(id) {
 const b=bookById(id); if(!b||!b.available){showToast("This book is currently unavailable.");return;}
 if(loans.some(l=>l.bookId===id&&l.studentId===currentUser.id&&!l.returned)){showToast("You already have this book on loan.");return;}
 if(!confirm(`Request "${b.title}"? In this demo, the request will be recorded as an issue.`))return;
 createLoan(b,currentUser.name,currentUser.id);
}
function issueBook(id) {
 if(role!=="admin"){showToast("Switch to Librarian Admin to issue books.");return;}
 const b=bookById(id);if(!b||b.available<1){showToast("No copies available.");return;}
 const name=prompt("Enter student name:",currentUser.name);if(!name?.trim())return;
 const sid=prompt("Enter student ID:",name===currentUser.name?currentUser.id:"STU2026002");if(!sid?.trim())return;
 if(loans.some(l=>l.bookId===id&&l.studentId===sid.trim()&&!l.returned)){showToast("This student already has this book.");return;}
 createLoan(b,name.trim(),sid.trim());
}
function createLoan(b,name,sid) {
 if(b.available<1){showToast("No copies available.");return;}
 b.available--;
 loans.push({id:nextLoanId++,bookId:b.id,student:name,studentId:sid,issue:dateOffset(0),due:dateOffset(14),returned:false});
 renderAll();showToast("Book issued successfully. Due in 14 days.");
}
function returnBook(id) {
 if(role!=="admin"){showToast("Only the librarian can record returns.");return;}
 const l=loans.find(x=>x.id===id);if(!l||l.returned)return;
 const b=bookById(l.bookId);const fine=fineFor(l);
 if(!confirm(`Record return${fine?`? Outstanding fine: ₹${fine}`:""}?`))return;
 l.returned=true;if(b)b.available=Math.min(b.total,b.available+1);
 renderAll();showToast(fine?`Book returned. Fine due: ₹${fine}`:"Book returned successfully.");
}
function openModal(title,fields,onSubmit) {
 $("modalTitle").textContent=title;$("modalFields").innerHTML=fields;
 $("modalForm").onsubmit=onSubmit;$("modalBackdrop").classList.add("open");
}
function closeModal(){$("modalBackdrop").classList.remove("open");}
function openBookModal() {
 editingBookId=null;
 openModal("Add new book",`
 <div class="form-group"><label>Book title</label><input class="field" name="title" required></div>
 <div class="form-group"><label>Author</label><input class="field" name="author" required></div>
 <div class="form-group"><label>ISBN</label><input class="field" name="isbn" required></div>
 <div class="form-group"><label>Category</label><select class="field" name="category"><option>Computer Science</option><option>Artificial Intelligence</option><option>Mathematics</option><option>Database</option><option>Literature</option></select></div>
 <div class="form-group"><label>Total copies</label><input class="field" type="number" name="total" min="1" value="1" required></div>`,
 e=>{e.preventDefault();const f=new FormData(e.target);const n=Number(f.get("total"));books.push({id:nextBookId++,title:f.get("title").trim(),author:f.get("author").trim(),isbn:f.get("isbn").trim(),category:f.get("category"),total:n,available:n,icon:"📘"});closeModal();renderAll();showToast("Book added to catalog.");});
}
function editBook(id) {
 const b=bookById(id);if(!b)return;editingBookId=id;
 openModal("Update book details",`
 <div class="form-group"><label>Book title</label><input class="field" name="title" value="${escapeHTML(b.title)}" required></div>
 <div class="form-group"><label>Author</label><input class="field" name="author" value="${escapeHTML(b.author)}" required></div>
 <div class="form-group"><label>ISBN</label><input class="field" name="isbn" value="${escapeHTML(b.isbn)}" required></div>
 <div class="form-group"><label>Total copies (minimum ${b.total-b.available} already issued)</label><input class="field" type="number" name="total" min="${b.total-b.available}" value="${b.total}" required></div>`,
 e=>{e.preventDefault();const f=new FormData(e.target),total=Number(f.get("total"));b.title=f.get("title").trim();b.author=f.get("author").trim();b.isbn=f.get("isbn").trim();b.available=total-(b.total-b.available);b.total=total;closeModal();renderAll();showToast("Book details updated.");});
}
function deleteBook(id) {
 const b=bookById(id);if(!b)return;
 if(loans.some(l=>l.bookId===id&&!l.returned)){showToast("Return all issued copies before deleting this book.");return;}
 if(!confirm(`Delete "${b.title}" from the catalog?`))return;
 books=books.filter(x=>x.id!==id);renderAll();showToast("Book deleted.");
}
function openMaterialModal() {
 openModal("Add study material",`
 <div class="form-group"><label>Material title</label><input class="field" name="title" required></div>
 <div class="form-group"><label>Description</label><input class="field" name="desc" required></div>
 <div class="form-group"><label>Academic year</label><select class="field" name="year"><option>1st Year</option><option>2nd Year</option><option>3rd Year</option><option>4th Year</option></select></div>
 <div class="form-group"><label>Semester</label><select class="field" name="semester"><option>Semester 1</option><option>Semester 2</option></select></div>
 <div class="form-group"><label>Subject</label><input class="field" name="subject" required></div>
 <div class="form-group"><label>Resource URL (optional)</label><input class="field" name="url" type="url" placeholder="https://..."></div>`,
 e=>{e.preventDefault();const f=new FormData(e.target);materials.push({id:nextMaterialId++,title:f.get("title").trim(),desc:f.get("desc").trim(),year:f.get("year"),semester:f.get("semester"),subject:f.get("subject").trim(),url:f.get("url").trim(),icon:"📄"});closeModal();renderMaterials();showToast("Study material added.");});
}
function deleteMaterial(id) {
 if(!confirm("Delete this study material?"))return;
 materials=materials.filter(m=>m.id!==id);renderMaterials();showToast("Material deleted.");
}
function downloadMaterial(id) {
 const m=materials.find(x=>x.id===id);if(!m)return;
 if(m.url){window.open(m.url,"_blank","noopener,noreferrer");return;}
 const text=`${m.title}\n\n${m.desc}\n\nSubject: ${m.subject}\nYear: ${m.year}\nSemester: ${m.semester}\n\nLibraSpace sample study resource. Replace this file with the actual college notes PDF.`;
 const url=URL.createObjectURL(new Blob([text],{type:"text/plain;charset=utf-8"}));
 const a=document.createElement("a");a.href=url;a.download=m.title.replace(/[^a-z0-9]/gi,"_")+".txt";a.click();URL.revokeObjectURL(url);
 showToast("Sample resource downloaded. Add a real PDF URL for actual notes.");
}
function openContact() {
 openModal("Contact librarian",`
 <div class="form-group"><label>Your email</label><input class="field" name="email" type="email" required value="${escapeHTML(currentUser.email)}"></div>
 <div class="form-group"><label>Subject</label><input class="field" name="subject" required placeholder="How can we help?"></div>
 <div class="form-group"><label>Message</label><textarea class="field" name="message" rows="4" style="width:100%;resize:vertical" required></textarea></div>`,
 e=>{e.preventDefault();closeModal();showToast("Demo message recorded locally. Connect a backend to send it.");});
}
function saveProfile(e) {
 e.preventDefault();
 currentUser.name=$("profileName").value.trim();currentUser.id=$("profileId").value.trim();
 currentUser.email=$("profileEmail").value.trim();currentUser.dept=$("profileDept").value;currentUser.year=$("profileYear").value;
 $("profileNameHeading").textContent=currentUser.name;
 $("topAvatar").textContent=currentUser.name.split(" ").map(x=>x[0]).join("").slice(0,2).toUpperCase();
