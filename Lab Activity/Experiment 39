
<!DOCTYPE html>
<html>
<head>
<title>Gourmet Haven</title>
<style>
body{font-family:Arial;margin:0;background:#fff8f0}
header{background:#713c2b;color:white;text-align:center;padding:30px}
nav{background:#3d241c;padding:15px;text-align:center}
nav a{color:white;margin:15px;text-decoration:none}
.container{max-width:850px;margin:25px auto;padding:20px}
.card{background:white;padding:20px;margin:15px 0;border-radius:10px;box-shadow:0 2px 8px #ccc}
input,select,button{padding:12px;margin:8px 0;width:100%;box-sizing:border-box}
button{background:#713c2b;color:white;border:0;cursor:pointer;border-radius:5px}
button:hover{background:#3d241c}
</style>
</head>
<body>
<header>
<h1>Gourmet Haven</h1>
<p>Delicious Food and Wonderful Dining</p>
</header>
<nav>
<a href="#menu">Menu</a>
<a href="#booking">Book a Table</a>
<a href="#contact">Contact</a>
</nav>
<div class="container">
<div class="card" id="menu">
<h2>Our Menu</h2>
<p>🍕 Pizza - ₹250</p>
<p>🍔 Burger - ₹150</p>
<p>🍝 Pasta - ₹200</p>
<p>🥗 Salad - ₹120</p>
<p>🍰 Chocolate Cake - ₹100</p>
</div>
<div class="card" id="booking">
<h2>Reserve a Table</h2>
<input id="customer" placeholder="Customer Name">
<input id="phone" type="tel" placeholder="Phone Number">
<input id="date" type="date">
<input id="time" type="time">
<select id="guests">
<option value="">Number of Guests</option>
<option>1</option><option>2</option><option>3</option>
<option>4</option><option>5</option><option>6</option>
</select>
<button onclick="bookTable()">Book Now</button>
<p id="result"></p>
</div>
<div class="card" id="contact">
<h2>Contact Us</h2>
<p>Address: Chennai, Tamil Nadu</p>
<p>Phone: 9876543210</p>
<p>Email: info@gourmethaven.com</p>
</div>
</div>
<script>
function bookTable(){
let n=document.getElementById("customer").value;
let p=document.getElementById("phone").value;
let d=document.getElementById("date").value;
let t=document.getElementById("time").value;
let g=document.getElementById("guests").value;
if(n===""||p===""||d===""||t===""||g===""){
alert("Please fill all booking details");
return;
}
document.getElementById("result").innerHTML=
"Table booking request received for "+n+". Guests: "+g+". Date: "+d+" at "+t;
}
</script>
</body>
</html>
