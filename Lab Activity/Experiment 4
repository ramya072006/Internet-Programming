function saveInventory(id,cls) {
  if(currentUser?.role!=="admin") return;

  const train=findTrain(id);
  const fare=Number($(`fare-${id}-${cls}`).value);
  const seats=Number($(`seats-${id}-${cls}`).value);

  if(!train||!Number.isFinite(fare)||fare<1||!Number.isInteger(seats)||seats<0||seats>1000) {
    toast("Enter a valid fare and whole-number seat count.");
    return;
  }

  train.fares[cls]=fare;
  train.seats[cls]=seats;

  if(save("trains",trains)) {
    renderAdmin();
    toast("Class fare and inventory updated.");
  }
}

function resetTrainForm() {
  $("trainAdminForm").reset();
  $("editTrainId").value="";
  $("adminDays").value="Daily";
}

$("trainAdminForm").addEventListener("submit",e=>{
  e.preventDefault();
  if(currentUser?.role!=="admin") return;

  const id=$("editTrainId").value;
  const old=findTrain(id);
  const no=$("adminTrainNo").value.trim();

  if(trains.some(t=>t.no===no&&t.id!==id)) {
    toast("That train number already exists.");
    return;
  }

  const obj={
    id:id||"t"+Date.now(),
    no,
    name:$("adminTrainName").value.trim(),
    type:$("adminTrainType").value,
    from:$("adminFrom").value.trim(),
    to:$("adminTo").value.trim(),
    departure:$("adminDeparture").value,
    arrival:$("adminArrival").value,
    duration:$("adminDuration").value.trim(),
    days:$("adminDays").value.trim(),
    fares:old?old.fares:{SL:450,"3A":1050,"2A":1550,"1A":2600,CC:650},
    seats:old?old.seats:{SL:40,"3A":20,"2A":10,"1A":4,CC:20}
  };

  if(obj.from.toLowerCase()===obj.to.toLowerCase()) {
    toast("Origin and destination must be different.");
    return;
  }

  if(old) trains=trains.map(t=>t.id===id?obj:t);
  else trains.push(obj);

  if(save("trains",trains)) {
    resetTrainForm();
    renderAdmin();
    toast("Train information saved.");
  }
});

function editTrain(id) {
  if(currentUser?.role!=="admin") return;
  const t=findTrain(id);
  if(!t) return;

  $("editTrainId").value=t.id;
  $("adminTrainNo").value=t.no;
  $("adminTrainName").value=t.name;
  $("adminTrainType").value=t.type;
  $("adminFrom").value=t.from;
  $("adminTo").value=t.to;
  $("adminDeparture").value=t.departure;
  $("adminArrival").value=t.arrival;
  $("adminDuration").value=t.duration;
  $("adminDays").value=t.days;
  $("trainAdminForm").scrollIntoView({behavior:"smooth",block:"center"});
}

function deleteTrain(id) {
  if(currentUser?.role!=="admin") return;
  const train=findTrain(id);
  if(!train||!confirm(`Delete ${train.name}? Existing booking records will remain.`)) return;

  trains=trains.filter(t=>t.id!==id);
  if(save("trains",trains)) {
    renderAdmin();
    toast("Train removed.");
  }
}

function deleteUser(id) {
  if(currentUser?.role!=="admin") return;
  const user=users.find(u=>u.id===id);
  if(!user||user.role==="admin"||!confirm(`Remove account ${user.email}?`)) return;

  users=users.filter(u=>u.id!==id);
  if(save("users",users)) {
    renderAdmin();
    toast("User account removed from this browser.");
  }
}

function adminCancel(pnr) {
  if(currentUser?.role!=="admin"||!confirm("Cancel this booking as administrator?")) return;
  const booking=bookings.find(b=>b.pnr===pnr);
  if(!booking||booking.status==="Cancelled") return;

  const days=Math.ceil((new Date(booking.date+"T00:00:00")-new Date(todayISO()+"T00:00:00"))/86400000);
  booking.status="Cancelled";
  booking.cancelledAt=new Date().toISOString();
  booking.refund=days>=refundRules.days?Math.round(booking.fare*refundRules.percent/100):0;
  booking.refundStatus=booking.refund?"Refund pending admin approval":"No refund";

  if(save("bookings",bookings)) {
    renderAdmin();
    toast("Reservation cancelled.");
  }
}

function approveRefund(pnr) {
  if(currentUser?.role!=="admin") return;
  const booking=bookings.find(b=>b.pnr===pnr);
  if(!booking||booking.status!=="Cancelled") return;

  booking.refundStatus=booking.refund>0?"Approved (demo only)":"No refund due";
  if(booking.refund>0) booking.paymentStatus="Refund approved (demo only)";

  if(save("bookings",bookings)) {
    renderAdmin();
    toast("Refund status updated in demo records.");
  }
}

$("refundRulesForm").addEventListener("submit",e=>{
  e.preventDefault();
  if(currentUser?.role!=="admin") return;

  const days=Number($("refundDays").value);
  const percent=Number($("refundPercent").value);

  if(!Number.isInteger(days)||days<0||days>60||!Number.isFinite(percent)||percent<0||percent>100) {
    toast("Enter valid refund rules.");
    return;
  }

  refundRules={days,percent};
  if(save("refundRules",refundRules)) {
    renderAdmin();
    toast("Refund rules saved.");
  }
});

function csvEscape(value) {
  return '"'+String(value??"").replace(/"/g,'""')+'"';
}

function downloadCSV(name,rows) {
  const csv=rows.map(row=>row.map(csvEscape).join(",")).join("\r\n");
  const blob=new Blob(["\ufeff"+csv],{type:"text/csv;charset=utf-8;"});
  const url=URL.createObjectURL(blob);
  const a=document.createElement("a");
  a.href=url;
  a.download=name;
  document.body.appendChild(a);
  a.click();
  a.remove();
  setTimeout(()=>URL.revokeObjectURL(url),1000);
}

function exportReport(type) {
  if(currentUser?.role!=="admin") {
    toast("Admin access required.");
    return;
  }

  if(type==="bookings") {
    downloadCSV("railconnect-booking-report.csv",[
      ["PNR","Passenger","Email","Train No","Train","Origin","Destination","Journey Date","Class","Seats","Fare","Payment Mode","Payment Status","Reservation Status","Refund","Refund Status"],
      ...bookings.map(b=>[b.pnr,b.passenger,b.email,b.trainNo,b.trainName,b.from,b.to,b.date,b.class,(b.seats||[]).join(" "),b.fare,b.paymentMode,b.paymentStatus,b.status,b.refund,b.refundStatus])
    ]);
  } else if(type==="trains") {
    downloadCSV("railconnect-train-report.csv",[
      ["Train No","Train Name","Type","Origin","Destination","Departure","Arrival","Duration","Days","Class","Fare","Listed Seats"],
      ...trains.flatMap(t=>Object.keys(CLASSES).map(c=>[t.no,t.name,t.type,t.from,t.to,t.departure,t.arrival,t.duration,t.days,c,t.fares[c],t.seats[c]]))
    ]);
  } else if(type==="users") {
    downloadCSV("railconnect-user-report.csv",[
      ["Name","Email","Phone","Role"],
      ...users.map(u=>[u.name,u.email,u.phone,u.role])
    ]);
  } else if(type==="payments") {
    downloadCSV("railconnect-payment-report.csv",[
      ["PNR","Email","Fare","Mode","Payment Status","Reservation Status","Refund","Refund Status"],
      ...bookings.map(b=>[b.pnr,b.email,b.fare,b.paymentMode,b.paymentStatus,b.status,b.refund,b.refundStatus])
    ]);
  }

  toast("CSV report generated.");
}

function populateCommentTrains() {
  $("commentTrain").innerHTML=trains.map(t=>
    `<option value="${safe(t.id)}">${safe(t.no)} — ${safe(t.name)}</option>`
  ).join("");
}

$("commentForm").addEventListener("submit",e=>{
  e.preventDefault();

  if(!currentUser) {
    toast("Please log in to post feedback.");
    showPage("loginPage");
    return;
  }

  const train=findTrain($("commentTrain").value);
  const text=$("commentText").value.trim();

  if(!train||!text) {
    toast("Select a train and enter a comment.");
    return;
  }

  comments.unshift({
    id:"c"+Date.now(),
    userId:currentUser.id,
    name:currentUser.name,
    trainId:train.id,
    trainName:train.name,
    rating:Number($("commentRating").value),
    text,
    date:new Date().toISOString()
  });

  if(save("comments",comments)) {
    $("commentText").value="";
    renderComments();
    toast("Your feedback was posted.");
  }
});

function renderComments() {
  populateCommentTrains();

  const list=$("commentsList");
  list.innerHTML=comments.length?comments.map(c=>`
    <div class="train-card">
      <div class="train-top">
        <div>
          <strong>${safe(c.name)}</strong>
          <div class="small muted">${safe(c.trainName)} · ${new Date(c.date).toLocaleDateString()}</div>
        </div>
        <span style="color:#d28b00">${"★".repeat(Math.max(0,Math.min(5,Number(c.rating)||0)))}${"☆".repeat(5-Math.max(0,Math.min(5,Number(c.rating)||0)))}</span>
      </div>
      <p>${safe(c.text)}</p>
      ${currentUser?.role==="admin"?`<button class="btn btn-danger btn-small" onclick="deleteComment('${c.id}')">Remove feedback</button>`:""}
    </div>`).join(""):'<div class="empty"><strong>No feedback yet</strong>Be the first to share your experience.</div>';
}

function deleteComment(id) {
  if(currentUser?.role!=="admin") return;
  comments=comments.filter(c=>c.id!==id);
  if(save("comments",comments)) {
    renderComments();
    toast("Feedback removed.");
  }
}

// Refresh displayed train results when filters change.
["searchClass","sortTrains","maxFare"].forEach(id=>{
  $(id).addEventListener("change",()=>{
    if($("trainResults").innerHTML) searchTrains();
  });
});

seedDemo();
updateHeader();
populateCommentTrains();
renderComments();
</script>
