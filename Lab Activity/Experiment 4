$("passengerForm").addEventListener("submit",e=>{
  e.preventDefault();

  if(!currentUser) {
    toast("Please log in first.");
    showPage("loginPage");
    return;
  }

  if(selectedSeats.length!==bookingPassengerCount) {
    toast(`Please select exactly ${bookingPassengerCount} seat(s).`);
    return;
  }

  // Recheck seats immediately before saving the booking.
  const available=getAvailableSeats(selectedTrain,selectedClass,searchDateValue);
  if(selectedSeats.some(seat=>!available.includes(seat))) {
    toast("A selected seat is no longer available. Please select again.");
    renderBookingForm();
    return;
  }

  const fd=new FormData(e.target);
  const passengers=[];

  for(let i=0;i<bookingPassengerCount;i++) {
    passengers.push({
      name:String(fd.get("pname"+i)).trim(),
      age:Number(fd.get("page"+i)),
      gender:String(fd.get("pgender"+i)),
      preference:String(fd.get("ppref"+i))
    });
  }

  let pnr;
  do {
    pnr=String(Math.floor(1000000000+Math.random()*9000000000));
  } while(bookings.some(b=>b.pnr===pnr));

  const paymentMode=$("paymentMode").value;
  const booking={
    id:"b"+Date.now(),
    pnr,
    userId:currentUser.id,
    email:$("bookingEmail").value.trim(),
    passenger:passengers[0].name,
    passengers,
    trainId:selectedTrain.id,
    trainName:selectedTrain.name,
    trainNo:selectedTrain.no,
    from:selectedTrain.from,
    to:selectedTrain.to,
    date:searchDateValue,
    departure:selectedTrain.departure,
    arrival:selectedTrain.arrival,
    class:selectedClass,
    seats:[...selectedSeats],
    fare:selectedTrain.fares[selectedClass]*bookingPassengerCount,
    paymentMode,
    paymentStatus:paymentMode==="online"?"Demo successful":"Pending at counter",
    status:"Confirmed",
    createdAt:new Date().toISOString(),
    cancelledAt:null,
    refund:0,
    refundStatus:"Not applicable"
  };

  bookings.push(booking);

  if(!save("bookings",bookings)) {
    bookings=bookings.filter(b=>b.id!==booking.id);
    return;
  }

  activePnr=pnr;
  renderTicket(booking);
  toast("Demo reservation created. PNR: "+pnr);
  showPage("ticketPage");
});

