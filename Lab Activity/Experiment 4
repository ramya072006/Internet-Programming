$("cancelForm").addEventListener("submit",e=>{
  e.preventDefault();
  showCancelResult($("cancelPnr").value.trim());
});

function showCancelResult(pnr) {
  const booking=bookings.find(b=>b.pnr===pnr);

  if(!booking) {
    $("cancelResult").innerHTML='<div class="empty"><strong>Booking not found</strong>Check the PNR and try again.</div>';
    return;
  }

  if(!currentUser) {
    $("cancelResult").innerHTML='<div class="notice">Please log in to request a cancellation.</div>';
    return;
  }

  if(currentUser.role!=="admin"&&booking.userId!==currentUser.id) {
    $("cancelResult").innerHTML='<div class="notice">You can only cancel a reservation associated with your account.</div>';
    return;
  }

  const days=Math.ceil((new Date(booking.date+"T00:00:00")-new Date(todayISO()+"T00:00:00"))/86400000);
  const eligible=days>=Number(refundRules.days);
  const refund=eligible?Math.round(booking.fare*Number(refundRules.percent)/100):0;

  $("cancelResult").innerHTML=`
    <div class="panel">
      <h3>${safe(booking.trainName)}</h3>
      <p>PNR: <strong>${safe(booking.pnr)}</strong> · Journey: ${safe(booking.date)}</p>
      <p>${safe(booking.from)} → ${safe(booking.to)} · ${safe(booking.class)} · ${money(booking.fare)}</p>
      <p>Current status: <span class="pill ${statusClass(booking.status)}">${safe(booking.status)}</span></p>
      ${booking.status==="Cancelled"
        ? `<div class="notice success">This booking is already cancelled. Recorded refund: ${money(booking.refund)}. ${safe(booking.refundStatus||"")}</div>`
        : `<div class="notice">${eligible
          ? `Estimated refund: ${money(refund)} (${refundRules.percent}%).`
          : `The demo rule requires cancellation at least ${refundRules.days} day(s) before departure. Estimated refund: ₹0.`}
          Days until journey: ${Math.max(0,days)}.</div>
          <button class="btn btn-danger" onclick="cancelBooking('${booking.pnr}')">Submit cancellation request</button>`}
    </div>`;
}

function cancelBooking(pnr) {
  const booking=bookings.find(b=>b.pnr===pnr);
  if(!booking||booking.status==="Cancelled") return;

  if(!currentUser||(currentUser.role!=="admin"&&booking.userId!==currentUser.id)) {
    toast("You are not authorized to cancel this booking.");
    return;
  }

  if(!confirm("Are you sure you want to cancel this demo reservation?")) return;

  const days=Math.ceil((new Date(booking.date+"T00:00:00")-new Date(todayISO()+"T00:00:00"))/86400000);
  booking.refund=days>=Number(refundRules.days)
    ? Math.round(booking.fare*Number(refundRules.percent)/100)
    : 0;
  booking.status="Cancelled";
  booking.cancelledAt=new Date().toISOString();
  booking.refundStatus=booking.refund>0?"Refund pending admin approval":"No refund";

  if(!save("bookings",bookings)) return;

  showCancelResult(pnr);
  toast("Cancellation recorded.");
  if(currentUser?.role==="admin") renderAdmin();
}

