
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>RailConnect | Train Reservation System</title>
<style>
:root {
  --navy:#102a43;
  --blue:#1769aa;
  --blue2:#e8f3fc;
  --gold:#f5b544;
  --green:#16794b;
  --red:#b42318;
  --ink:#243447;
  --muted:#64748b;
  --line:#dce5ee;
  --bg:#f4f7fb;
  --white:#fff;
  --shadow:0 12px 35px #102a4310;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;font-family:Arial,Helvetica,sans-serif;background:var(--bg);color:var(--ink)}
button,input,select,textarea{font:inherit}
button{cursor:pointer}
button:disabled{cursor:not-allowed;opacity:.55}
a{color:var(--blue)}
.topbar{background:var(--navy);color:#fff;padding:10px 5%;display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;font-size:13px}
.navbar{background:#fff;display:flex;align-items:center;justify-content:space-between;padding:16px 5%;gap:20px;position:sticky;top:0;z-index:10;box-shadow:0 3px 15px #102a4310}
.brand{font-size:22px;font-weight:800;color:var(--navy);white-space:nowrap}
.brand span{color:var(--blue)}
nav{display:flex;gap:6px;align-items:center;flex-wrap:wrap}
nav button{border:0;background:transparent;color:var(--ink);font-weight:700;padding:10px;border-radius:8px}
nav button:hover,nav button.active{background:var(--blue2);color:var(--blue)}
.btn{border:0;border-radius:9px;padding:11px 16px;font-weight:700;transition:.15s}
.btn-primary{background:var(--blue);color:#fff}
.btn-primary:hover{background:#10558b}
.btn-dark{background:var(--navy);color:#fff}
.btn-outline{border:1px solid var(--line);background:#fff;color:var(--navy)}
.btn-danger{background:#fff0ee;color:var(--red)}
.btn-small{padding:7px 10px;font-size:12px}
.hero{background:linear-gradient(120deg,#102a43ed,#1769aadd);color:#fff;padding:52px 5% 64px}
.hero-inner{max-width:1200px;margin:auto;display:grid;grid-template-columns:1.1fr .9fr;gap:32px;align-items:center}
.eyebrow{font-size:12px;font-weight:800;letter-spacing:1.5px;color:#ffd078;text-transform:uppercase}
.hero h1{font-size:clamp(30px,4vw,48px);line-height:1.1;margin:14px 0}
.hero p{color:#e0edf7;line-height:1.7;max-width:600px}
.hero-card{background:#fff;color:var(--ink);border-radius:18px;padding:24px;box-shadow:0 20px 50px #00172e30}
.hero-card h2{margin:0 0 18px;color:var(--navy)}
.search-grid{display:grid;grid-template-columns:1fr 1fr;gap:13px}
.field{display:flex;flex-direction:column;gap:7px;min-width:0}
.field label{font-size:12px;color:var(--muted);font-weight:700}
.field input,.field select,.field textarea{width:100%;padding:12px;border:1px solid var(--line);border-radius:9px;background:#fff;color:var(--ink);outline:none}
.field input:focus,.field select:focus,.field textarea:focus{border-color:var(--blue);box-shadow:0 0 0 3px #1769aa18}
.field.full{grid-column:1/-1}
.search-grid .btn{grid-column:1/-1;padding:13px}
.container{max-width:1200px;margin:auto;padding:30px 5% 55px}
.page{display:none}
.page.active{display:block}
.section-head{display:flex;justify-content:space-between;align-items:flex-end;gap:15px;flex-wrap:wrap;margin-bottom:20px}
.section-head h2{margin:0;color:var(--navy)}
.section-head p{margin:7px 0 0;color:var(--muted)}
.features{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin:28px 0}
.feature,.panel,.card,.stat{background:#fff;border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow)}
.feature{padding:20px}
.feature .icon{font-size:25px}
.feature h3{margin:12px 0 7px;color:var(--navy);font-size:16px}
.feature p{font-size:13px;line-height:1.6;color:var(--muted);margin:0 0 12px}
.panel{padding:22px;margin-bottom:20px}
.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
.form-grid.three{grid-template-columns:repeat(3,minmax(0,1fr))}
.form-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}
.notice{background:#fff8e7;border:1px solid #f4dda5;color:#75500c;border-radius:10px;padding:12px 14px;font-size:13px;line-height:1.5;margin:12px 0}
.success{background:#e9f8ef;border:1px solid #b9e5c9;color:#17633c}
.muted{color:var(--muted)}
.small{font-size:12px}
.train-list{display:grid;gap:15px}
.train-card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:20px;box-shadow:var(--shadow)}
.train-top{display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap}
.train-name{font-size:18px;font-weight:800;color:var(--navy)}
.train-no{font-size:12px;color:var(--muted);margin-top:5px}
.tag{display:inline-flex;background:#e8f3fc;color:#1769aa;padding:5px 9px;border-radius:30px;font-size:11px;font-weight:800;align-items:center}
.route{display:grid;grid-template-columns:1fr minmax(80px,1fr) 1fr;gap:12px;align-items:center;margin:20px 0}
.station strong{font-size:22px;color:var(--navy);display:block}
.station span{font-size:12px;color:var(--muted)}
.station:last-child{text-align:right}
.route-line{text-align:center;color:var(--blue);font-size:12px}
.route-line:before{content:"";display:block;border-top:2px dashed #9dbbd5;margin-bottom:8px}
.train-bottom{border-top:1px solid var(--line);padding-top:14px;display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap}
.class-options{display:flex;gap:8px;flex-wrap:wrap;margin-top:15px}
.class-btn{border:1px solid var(--line);background:#fff;padding:10px 12px;border-radius:9px;text-align:left;min-width:112px}
.class-btn strong{display:block;color:var(--navy);margin-bottom:4px}
.class-btn small{color:var(--muted)}
.class-btn:hover{border-color:var(--blue);background:var(--blue2)}
.seat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;max-width:450px}
.seat{padding:12px 5px;border:1px solid #a9c6df;border-radius:9px;background:#edf6fd;color:var(--navy);font-weight:800}
.seat.booked{background:#f1f3f5;border-color:#d7dde4;color:#a0aab5;cursor:not-allowed;text-decoration:line-through}
.seat.selected{background:var(--blue);border-color:var(--blue);color:#fff}
.legend{display:flex;gap:14px;flex-wrap:wrap;font-size:12px;color:var(--muted);margin:15px 0}
.dot{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:5px;background:#edf6fd;border:1px solid #a9c6df}
.dot.booked{background:#f1f3f5;border-color:#d7dde4}
.dot.selected{background:var(--blue)}
.table-wrap{overflow:auto}
table{border-collapse:collapse;width:100%;min-width:680px;font-size:13px}
th,td{text-align:left;padding:12px;border-bottom:1px solid var(--line);vertical-align:top}
th{background:#f3f7fb;color:var(--navy);font-size:12px;text-transform:uppercase;letter-spacing:.3px}
td .btn{margin:2px}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:20px}
.stat{padding:18px}
.stat span{font-size:12px;color:var(--muted)}
.stat strong{display:block;font-size:26px;color:var(--navy);margin-top:7px}
.empty{padding:35px;text-align:center;border:1px dashed #c8d6e3;border-radius:12px;color:var(--muted);background:#fff}
.empty strong{display:block;color:var(--navy);margin-bottom:8px}
.two-col{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.footer{background:var(--navy);color:#d9e6f1;padding:30px 5%;display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;font-size:13px}
.footer strong{color:#fff}
.toast{position:fixed;right:20px;bottom:20px;background:#102a43;color:#fff;padding:14px 18px;border-radius:10px;box-shadow:var(--shadow);z-index:50;max-width:360px;display:none}
.toast.show{display:block;animation:pop .2s ease}
@keyframes pop{from{transform:translateY(8px);opacity:0}to{transform:translateY(0);opacity:1}}
.hidden{display:none!important}
.pill{display:inline-block;border-radius:30px;padding:5px 9px;font-size:11px;font-weight:800}
.pill.confirmed{background:#e4f7eb;color:#16794b}
.pill.rac{background:#fff4d8;color:#875c00}
.pill.waiting{background:#fff0ee;color:#b42318}
.pill.cancelled{background:#eef1f5;color:#64748b}
.ticket{border:1px dashed #8aa9c3;background:#fff;border-radius:14px;padding:22px;max-width:760px}
.ticket h3{margin-top:0;color:var(--navy)}
.ticket-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}
.ticket-grid div span{display:block;color:var(--muted);font-size:11px;margin-bottom:4px}
.ticket-grid strong{color:var(--navy);overflow-wrap:anywhere}
.ticket-pnr{font-size:24px;letter-spacing:2px;color:var(--blue)}
.booking-summary{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:16px}
.booking-summary div{background:#f4f8fc;border:1px solid var(--line);border-radius:10px;padding:13px}
.booking-summary span{display:block;color:var(--muted);font-size:12px;margin-bottom:6px}
.booking-summary strong{color:var(--navy);overflow-wrap:anywhere}
.print-only{display:none}
@media(max-width:850px){
 .hero-inner{grid-template-columns:1fr}
 .features{grid-template-columns:repeat(2,1fr)}
 .stats{grid-template-columns:repeat(2,1fr)}
 .form-grid.three{grid-template-columns:repeat(2,minmax(0,1fr))}
 .navbar{align-items:flex-start;flex-direction:column}
 nav{width:100%}
 .two-col{grid-template-columns:1fr}
}
@media(max-width:520px){
 .hero{padding:35px 5% 42px}
 .search-grid,.form-grid,.form-grid.three{grid-template-columns:1fr}
 .features{grid-template-columns:1fr 1fr;gap:10px}
 .feature{padding:14px}
 .feature p{font-size:12px}
 .container{padding-top:22px}
 .route{grid-template-columns:1fr 60px 1fr}
 .station strong{font-size:18px}
 .train-card{padding:15px}
 .seat-grid{gap:7px}
 .seat{padding:10px 3px}
 .stats{gap:9px}
 .stat{padding:13px}
 .stat strong{font-size:22px}
 .ticket-grid,.booking-summary{grid-template-columns:1fr 1fr}
}
@media print{
 body{background:#fff}
 .topbar,.navbar,.hero,.footer,.no-print,.toast{display:none!important}
 .page{display:none!important}
 #ticketPage{display:block!important}
 .container{padding:0;max-width:none}
 .ticket{max-width:none;border:1px solid #999}
 .print-only{display:block}
}
</style>
</head>
<body>

<div class="topbar">
  <span>🚆 RailConnect — simple, reliable train reservations</span>
  <span id="topStatus">Guest mode · Demo system</span>
</div>

<header class="navbar">
  <div class="brand">🚆 Rail<span>Connect</span></div>
  <nav id="mainNav">
    <button data-page="homePage" class="active">Home</button>
    <button data-page="trainsPage">Find Trains</button>
    <button data-page="pnrPage">PNR Status</button>
    <button data-page="dashboardPage">My Bookings</button>
    <button data-page="cancelPage">Cancellation</button>
    <button data-page="commentsPage">Feedback</button>
    <button data-page="loginPage" id="loginNav">Login</button>
    <button data-page="registerPage" id="registerNav">Register</button>
    <button data-page="adminPage" id="adminNav">Admin</button>
  </nav>
</header>

<main>
<section id="homePage" class="page active">
  <div class="hero">
    <div class="hero-inner">
      <div>
        <div class="eyebrow">Your journey starts here</div>
        <h1>Every journey,<br>one easy reservation.</h1>
        <p>Search trains, compare classes, check seat availability, reserve tickets and track your PNR — all in one convenient place.</p>
        <div class="form-actions">
          <button class="btn btn-primary" onclick="showPage('trainsPage')">Find your train →</button>
          <button class="btn btn-outline" onclick="showPage('pnrPage')">Check PNR status</button>
        </div>
      </div>

      <div class="hero-card">
        <h2>Search trains</h2>
        <div class="search-grid">
          <div class="field">
            <label for="homeFrom">FROM STATION</label>
            <input id="homeFrom" list="stations" placeholder="e.g. Mumbai Central">
          </div>
          <div class="field">
            <label for="homeTo">TO STATION</label>
            <input id="homeTo" list="stations" placeholder="e.g. New Delhi">
          </div>
          <div class="field">
            <label for="homeDate">JOURNEY DATE</label>
            <input id="homeDate" type="date">
          </div>
          <div class="field">
            <label for="homeClass">TRAVEL CLASS</label>
            <select id="homeClass">
              <option value="all">All classes</option>
              <option value="SL">Sleeper (SL)</option>
              <option value="3A">AC 3 Tier (3A)</option>
              <option value="2A">AC 2 Tier (2A)</option>
              <option value="1A">First AC (1A)</option>
              <option value="CC">Chair Car (CC)</option>
            </select>
          </div>
          <button class="btn btn-primary" onclick="searchFromHome()">Search available trains</button>
        </div>
      </div>
    </div>
  </div>

  <div class="container">
    <div class="features">
      <div class="feature"><div class="icon">🔎</div><h3>Smart train search</h3><p>Search by route, train name, number, date and class.</p></div>
      <div class="feature"><div class="icon">💺</div><h3>Seat selection</h3><p>Choose seats and view passenger totals before booking.</p></div>
      <div class="feature"><div class="icon">🎫</div><h3>PNR and tickets</h3><p>Track reservations, view booking history and print tickets.</p></div>
      <div class="feature"><div class="icon">↩️</div><h3>Cancellation</h3><p>Cancel demo bookings and view estimated refunds.</p></div>
    </div>

    <div class="section-head">
      <div><h2>Popular routes</h2><p>Choose a route to start searching.</p></div>
    </div>

    <div class="features">
      <div class="feature"><h3>Mumbai → New Delhi</h3><p>Long-distance express services</p><button class="btn btn-outline btn-small" onclick="quickRoute('Mumbai Central','New Delhi')">Search route</button></div>
      <div class="feature"><h3>Chennai → Bengaluru</h3><p>Popular intercity connection</p><button class="btn btn-outline btn-small" onclick="quickRoute('Chennai Central','Bengaluru City')">Search route</button></div>
      <div class="feature"><h3>Hyderabad → Vijayawada</h3><p>Regional travel connection</p><button class="btn btn-outline btn-small" onclick="quickRoute('Hyderabad Deccan','Vijayawada')">Search route</button></div>
      <div class="feature"><h3>Kolkata → Patna</h3><p>Eastern route connection</p><button class="btn btn-outline btn-small" onclick="quickRoute('Kolkata','Patna')">Search route</button></div>
    </div>

    <div class="notice">Student/demo project: train schedules, fares, PNR status and refunds are sample data stored in this browser. This is not connected to a live railway reservation network.</div>
  </div>
</section>

<section id="loginPage" class="page">
  <div class="container">
    <div class="section-head"><div><h2>Passenger login</h2><p>Sign in to book tickets and manage reservations.</p></div></div>
    <div class="panel" style="max-width:620px">
      <form id="loginForm">
        <div class="form-grid">
          <div class="field full"><label>Email address</label><input id="loginEmail" type="email" required placeholder="you@example.com"></div>
          <div class="field full"><label>Password</label><input id="loginPassword" type="password" required minlength="4" placeholder="Enter password"></div>
        </div>
        <div class="form-actions">
          <button class="btn btn-primary" type="submit">Login</button>
          <button class="btn btn-outline" type="button" onclick="showPage('forgotPage')">Forgot password?</button>
        </div>
      </form>
      <p class="small muted">New passenger? <a href="#" onclick="showPage('registerPage');return false">Create an account</a></p>
      <div class="notice">Demo user: user@railconnect.demo / user123<br>Demo admin: admin@railconnect.demo / admin123</div>
    </div>
  </div>
</section>

<section id="registerPage" class="page">
  <div class="container">
    <div class="section-head"><div><h2>Create passenger account</h2><p>Register to reserve tickets and manage your journey.</p></div></div>
    <div class="panel" style="max-width:800px">
      <form id="registerForm">
        <div class="form-grid">
          <div class="field"><label>Full name</label><input id="regName" required maxlength="80"></div>
          <div class="field"><label>Email address</label><input id="regEmail" type="email" required></div>
          <div class="field"><label>Phone number</label><input id="regPhone" type="tel" required pattern="[0-9+ ()-]{8,18}"></div>
          <div class="field"><label>Password</label><input id="regPassword" type="password" required minlength="6"></div>
        </div>
        <div class="form-actions">
          <button class="btn btn-primary">Register</button>
          <button class="btn btn-outline" type="button" onclick="showPage('loginPage')">Already registered? Login</button>
        </div>
      </form>
    </div>
  </div>
</section>

<section id="forgotPage" class="page">
  <div class="container">
    <div class="section-head"><div><h2>Reset password</h2><p>Use the demo reset flow to set a new password.</p></div></div>
    <div class="panel" style="max-width:620px">
      <form id="forgotForm">
        <div class="form-grid">
          <div class="field full"><label>Registered email</label><input id="forgotEmail" type="email" required></div>
          <div class="field full"><label>New password</label><input id="forgotPassword" type="password" minlength="6" required></div>
        </div>
        <div class="form-actions">
          <button class="btn btn-primary">Update password</button>
          <button class="btn btn-outline" type="button" onclick="showPage('loginPage')">Back to login</button>
        </div>
      </form>
      <div class="notice">This demo updates the browser record only. A real password reset requires a secure backend and email service.</div>
    </div>
  </div>
</section>

<section id="trainsPage" class="page">
  <div class="container">
    <div class="section-head">
      <div><h2>Find available trains</h2><p>Search, filter and compare the sample timetable.</p></div>
      <button class="btn btn-outline" onclick="showPage('homePage')">← Home</button>
    </div>

    <div class="panel">
      <div class="form-grid three">
        <div class="field"><label>Origin station</label><input id="searchFrom" list="stations" placeholder="Origin station"></div>
        <div class="field"><label>Destination station</label><input id="searchTo" list="stations" placeholder="Destination station"></div>
        <div class="field"><label>Journey date</label><input id="searchDate" type="date"></div>

        <div class="field"><label>Train name or number</label><input id="searchTrainName" type="search" placeholder="e.g. Rajdhani or 12951"></div>
        <div class="field"><label>Class</label>
          <select id="searchClass">
            <option value="all">All classes</option>
            <option value="SL">Sleeper (SL)</option>
            <option value="3A">AC 3 Tier (3A)</option>
            <option value="2A">AC 2 Tier (2A)</option>
            <option value="1A">First AC (1A)</option>
            <option value="CC">Chair Car (CC)</option>
          </select>
        </div>
        <div class="field"><label>Passengers</label>
          <select id="searchPassengers">
            <option>1</option><option>2</option><option>3</option><option>4</option><option>5</option><option>6</option>
          </select>
        </div>
        <div class="field"><label>Maximum fare (₹)</label><input id="maxFare" type="number" min="1" placeholder="No limit"></div>
        <div class="field"><label>Sort results</label>
          <select id="sortTrains">
            <option value="recommended">Recommended</option>
            <option value="fare">Lowest fare</option>
            <option value="departure">Earliest departure</option>
            <option value="seats">Most available seats</option>
          </select>
        </div>
        <div class="field" style="justify-content:end">
          <button class="btn btn-primary" onclick="searchTrains()">Search trains</button>
          <button class="btn btn-outline" onclick="swapStations()">⇄ Swap stations</button>
        </div>
      </div>
    </div>
    <div id="trainResultCount" class="small muted" style="margin-bottom:12px"></div>
    <div id="trainResults" class="train-list"></div>
  </div>
</section>

<section id="bookingPage" class="page">
  <div class="container">
    <div class="section-head">
      <div><h2>Reserve your ticket</h2><p>Select seats and provide passenger details.</p></div>
      <button class="btn btn-outline" onclick="showPage('trainsPage')">← Back to trains</button>
    </div>
    <div id="bookingSummary" class="panel"></div>
    <div class="two-col">
      <div class="panel">
        <h3>1. Choose seats</h3>
        <p class="muted small">Blue = available · Dark blue = selected · Grey = unavailable</p>
        <div class="legend">
          <span><i class="dot"></i>Available</span>
          <span><i class="dot selected"></i>Selected</span>
          <span><i class="dot booked"></i>Unavailable</span>
        </div>
        <div id="seatGrid" class="seat-grid"></div>
        <p id="seatCount" class="small muted"></p>
      </div>

      <div class="panel">
        <h3>2. Passenger details</h3>
        <form id="passengerForm">
          <div id="passengerFields"></div>
          <div class="field" style="margin-top:15px">
            <label>Payment mode</label>
            <select id="paymentMode">
              <option value="online">Online payment (demo)</option>
              <option value="offline">Offline / counter payment (demo)</option>
            </select>
          </div>
          <div class="field" style="margin-top:15px">
            <label>Contact email for confirmation</label>
            <input id="bookingEmail" type="email" required>
          </div>
          <div class="notice">Demo checkout only. Do not enter real payment-card or banking information.</div>
          <div class="form-actions"><button class="btn btn-primary" type="submit">Confirm booking</button></div>
        </form>
      </div>
    </div>
  </div>
</section>

<section id="ticketPage" class="page">
  <div class="container">
    <div class="section-head no-print">
      <div><h2>Your reservation ticket</h2><p>Save the PNR and print this demo ticket.</p></div>
      <div class="form-actions">
        <button class="btn btn-primary" onclick="window.print()">🖨 Print ticket</button>
        <button class="btn btn-outline" onclick="showPage('dashboardPage')">My bookings</button>
      </div>
    </div>
    <div id="ticketContent"></div>
    <p class="small muted no-print">This is a demo ticket, not a valid railway travel document.</p>
  </div>
</section>

<section id="pnrPage" class="page">
  <div class="container">
    <div class="section-head"><div><h2>Check PNR status</h2><p>Enter your 10-digit demo PNR number.</p></div></div>
    <div class="panel" style="max-width:760px">
      <form id="pnrForm">
