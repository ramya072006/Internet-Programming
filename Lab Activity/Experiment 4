  {id:"t6",no:"11029",name:"Koyna Express",type:"Intercity",from:"Mumbai Central",to:"Pune Junction",departure:"08:40",arrival:"12:35",duration:"3h 55m",days:"Daily",fares:{SL:180,"3A":620,"2A":950,"1A":0,CC:420},seats:{SL:50,"3A":12,"2A":5,"1A":0,CC:18}},
  {id:"t7",no:"20805",name:"Visakhapatnam Express",type:"Express",from:"Visakhapatnam",to:"Secunderabad",departure:"19:00",arrival:"07:20",duration:"12h 20m",days:"Daily",fares:{SL:360,"3A":980,"2A":1450,"1A":2400,CC:0},seats:{SL:35,"3A":14,"2A":7,"1A":2,CC:0}},
  {id:"t8",no:"12933",name:"Karnavati Express",type:"Superfast",from:"Ahmedabad",to:"Mumbai Central",departure:"04:50",arrival:"13:10",duration:"8h 20m",days:"Daily",fares:{SL:0,"3A":0,"2A":0,"1A":0,CC:720},seats:{SL:0,"3A":0,"2A":0,"1A":0,CC:25}},
  {id:"t9",no:"12759",name:"Charminar Express",type:"Express",from:"Chennai Central",to:"Hyderabad Deccan",departure:"18:10",arrival:"07:30",duration:"13h 20m",days:"Daily",fares:{SL:380,"3A":1050,"2A":1520,"1A":0,CC:0},seats:{SL:40,"3A":18,"2A":8,"1A":0,CC:0}},
  {id:"t10",no:"22691",name:"Rajdhani Express",type:"Rajdhani",from:"Bengaluru City",to:"New Delhi",departure:"20:00",arrival:"05:30",duration:"33h 30m",days:"Daily",fares:{SL:0,"3A":2800,"2A":3900,"1A":6500,CC:0},seats:{SL:0,"3A":20,"2A":10,"1A":4,CC:0}},
  {id:"t11",no:"12839",name:"Chennai Mail",type:"Express",from:"Chennai Central",to:"Kolkata",departure:"23:00",arrival:"06:45",duration:"31h 45m",days:"Daily",fares:{SL:520,"3A":1450,"2A":2150,"1A":3600,CC:0},seats:{SL:45,"3A":22,"2A":12,"1A":3,CC:0}},
  {id:"t12",no:"12637",name:"Pandian Express",type:"Express",from:"Chennai Central",to:"Madurai Junction",departure:"21:40",arrival:"07:10",duration:"9h 30m",days:"Daily",fares:{SL:290,"3A":780,"2A":1150,"1A":1900,CC:0},seats:{SL:38,"3A":14,"2A":8,"1A":2,CC:0}},
  {id:"t13",no:"12295",name:"Sanghamitra Express",type:"Superfast",from:"Bengaluru City",to:"Patna",departure:"09:00",arrival:"18:20",duration:"33h 20m",days:"Daily",fares:{SL:620,"3A":1700,"2A":2550,"1A":4300,CC:0},seats:{SL:40,"3A":18,"2A":9,"1A":3,CC:0}}
];

const $ = id => document.getElementById(id);
const safe = s => String(s ?? "").replace(/[&<>"']/g,c=>({
  "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"
}[c]));
const money = n => "₹" + Number(n || 0).toLocaleString("en-IN");

function load(key,fallback) {
  try {
    const value = localStorage.getItem("railconnect_" + key);
    return value ? JSON.parse(value) : fallback;
  } catch(error) {
    console.warn("Unable to load saved data:",error);
    return fallback;
  }
}

function save(key,value) {
  try {
    localStorage.setItem("railconnect_" + key,JSON.stringify(value));
    return true;
  } catch(error) {
    console.error("Unable to save data:",error);
    toast("Unable to save data. Check browser storage settings.");
    return false;
  }
}

let trains = load("trains",DEFAULT_TRAINS);
let users = load("users",[]);
let bookings = load("bookings",[]);
let comments = load("comments",[]);
let refundRules = load("refundRules",{days:2,percent:80});
let currentUser = load("currentUser",null);
let selectedTrain = null;
let selectedClass = "SL";
let selectedSeats = [];
let bookingPassengerCount = 1;
let searchDateValue = "";
let activePnr = null;

function toast(message) {
  $("toast").textContent = message;
  $("toast").classList.add("show");
  clearTimeout(toast.timer);
  toast.timer = setTimeout(()=>$("toast").classList.remove("show"),3200);
}

function todayISO() {
  const d = new Date();
  return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,"0")}-${String(d.getDate()).padStart(2,"0")}`;
}

function seedDemo() {
  if(!users.some(u=>u.email.toLowerCase()==="user@railconnect.demo")) {
    users.push({id:"u-demo",name:"Demo Passenger",email:"user@railconnect.demo",phone:"9000000000",password:"user123",role:"user"});
  }
  if(!users.some(u=>u.email.toLowerCase()==="admin@railconnect.demo")) {
    users.push({id:"a-demo",name:"System Admin",email:"admin@railconnect.demo",phone:"9000000001",password:"admin123",role:"admin"});
  }

  // Add new sample trains to existing saved data without overwriting admin changes.
  DEFAULT_TRAINS.forEach(defaultTrain=>{
    if(!trains.some(t=>t.id===defaultTrain.id)) trains.push(defaultTrain);
  });

  save("users",users);
  save("trains",trains);
}

function findTrain(id) {
  return trains.find(t=>t.id===id);
}

function showPage(id) {
  if(id==="dashboardPage"&&!currentUser) {
    toast("Please log in to view your bookings.");
    id="loginPage";
  }

  document.querySelectorAll(".page").forEach(page=>{
    page.classList.toggle("active",page.id===id);
  });

  document.querySelectorAll("nav [data-page]").forEach(button=>{
    button.classList.toggle("active",button.dataset.page===id);
  });

  if(id==="dashboardPage") renderDashboard();
  if(id==="adminPage") renderAdmin();
  if(id==="commentsPage") renderComments();
  if(id==="trainsPage"&&!$("trainResults").innerHTML) searchTrains();

  window.scrollTo({top:0,behavior:"smooth"});
}

document.querySelectorAll("nav [data-page]").forEach(button=>{
  button.addEventListener("click",()=>{
    if(button.dataset.page==="logout") {
      logout();
    } else {
      showPage(button.dataset.page);
    }
  });
});

function logout() {
  currentUser=null;
  save("currentUser",null);
  updateHeader();
  toast("You have logged out.");
  showPage("homePage");
}

function updateHeader() {
  $("topStatus").textContent = currentUser
    ? `${currentUser.name} · ${currentUser.role==="admin"?"Administrator":"Passenger"}`
    : "Guest mode · Demo system";

  $("loginNav").textContent=currentUser?"Logout":"Login";
  $("loginNav").dataset.page=currentUser?"logout":"loginPage";
  $("registerNav").classList.toggle("hidden",!!currentUser);
  $("adminNav").classList.toggle("hidden",currentUser?.role!=="admin");
}

["homeDate","searchDate"].forEach(id=>{
  $(id).min=todayISO();
  $(id).value=todayISO();
});

function searchFromHome() {
  $("searchFrom").value=$("homeFrom").value;
  $("searchTo").value=$("homeTo").value;
  $("searchDate").value=$("homeDate").value||todayISO();
  $("searchClass").value=$("homeClass").value;
  $("searchTrainName").value="";
  $("maxFare").value="";
  showPage("trainsPage");
  searchTrains();
}

function quickRoute(from,to) {
  $("searchFrom").value=from;
  $("searchTo").value=to;
  $("searchDate").value=todayISO();
  $("searchClass").value="all";
  $("searchTrainName").value="";
  $("maxFare").value="";
  showPage("trainsPage");
  searchTrains();
}

function swapStations() {
  const from=$("searchFrom");
  const to=$("searchTo");
  [from.value,to.value]=[to.value,from.value];
  searchTrains();
  toast("Origin and destination swapped.");
}

function searchTrains() {
  const from=$("searchFrom").value.trim().toLowerCase();
  const to=$("searchTo").value.trim().toLowerCase();
  const cls=$("searchClass").value;
  const query=$("searchTrainName").value.trim().toLowerCase();
  const maxValue=$("maxFare").value;
  const maxFare=maxValue===""?Infinity:Number(maxValue);
  const sortBy=$("sortTrains").value;

  searchDateValue=$("searchDate").value||todayISO();

  if(searchDateValue<todayISO()) {
    toast("Choose today or a future journey date.");
    return;
  }

  if(maxValue!==""&&(!Number.isFinite(maxFare)||maxFare<1)) {
    toast("Enter a valid maximum fare.");
    return;
  }

  let found=trains.filter(t=>{
    const routeMatches =
      (!from||t.from.toLowerCase().includes(from)) &&
      (!to||t.to.toLowerCase().includes(to));

    const trainMatches =
      !query ||
      t.name.toLowerCase().includes(query) ||
      t.no.toLowerCase().includes(query);

    const classes=Object.keys(CLASSES).filter(c=>
      (cls==="all"||cls===c) &&
      Number(t.fares[c])>0 &&
      Number(t.seats[c])>0 &&
      Number(t.fares[c])<=maxFare
    );

    return routeMatches&&trainMatches&&classes.length>0;
  });

  const lowestFare=t=>Math.min(...Object.keys(CLASSES)
    .filter(c=>(cls==="all"||cls===c)&&Number(t.fares[c])>0&&Number(t.seats[c])>0)
    .map(c=>Number(t.fares[c])<=maxFare?Number(t.fares[c]):Infinity));

  const totalSeats=t=>Object.keys(CLASSES)
    .filter(c=>cls==="all"||cls===c)
    .reduce((sum,c)=>sum+(Number(t.fares[c])<=maxFare?Number(t.seats[c]||0):0),0);

  if(sortBy==="fare") found.sort((a,b)=>lowestFare(a)-lowestFare(b));
  if(sortBy==="departure") found.sort((a,b)=>a.departure.localeCompare(b.departure));
  if(sortBy==="seats") found.sort((a,b)=>totalSeats(b)-totalSeats(a));

  $("trainResultCount").textContent=`${found.length} train(s) found`;

  const wrap=$("trainResults");

  if(!found.length) {
    wrap.innerHTML='<div class="empty"><strong>No matching trains found</strong>Try another route, train name, fare limit or class.</div>';
    return;
  }

  wrap.innerHTML=found.map(t=>{
    const availableClasses=Object.keys(CLASSES).filter(c=>
      Number(t.fares[c])>0 &&
      Number(t.seats[c])>0 &&
      (cls==="all"||cls===c) &&
      Number(t.fares[c])<=maxFare
    );

    return `
      <article class="train-card">
        <div class="train-top">
          <div>
            <div class="train-name">${safe(t.name)}</div>
            <div class="train-no">Train no. ${safe(t.no)} · ${safe(t.type)} · ${safe(t.days)}</div>
          </div>
          <span class="tag">${safe(t.duration)}</span>
        </div>
        <div class="route">
          <div class="station"><strong>${safe(t.departure)}</strong><span>${safe(t.from)}</span></div>
          <div class="route-line">Journey</div>
          <div class="station"><strong>${safe(t.arrival)}</strong><span>${safe(t.to)}</span></div>
        </div>
        <div class="small muted">Journey date: ${safe(searchDateValue)}</div>
        <div class="class-options">
          ${availableClasses.map(c=>`
            <button class="class-btn" onclick="startBooking('${t.id}','${c}',${Number($("searchPassengers").value||1)})">
              <strong>${c} · ${CLASSES[c].name}</strong>
              <small>${Number(t.seats[c])} listed seats · ${money(t.fares[c])}</small>
            </button>
          `).join("")}
        </div>
        <div class="train-bottom">
          <span class="small muted">Choose a class to continue</span>
          <button class="btn btn-primary btn-small" onclick="startBooking('${t.id}','${availableClasses[0]}',${Number($("searchPassengers").value||1)})">Book now →</button>
        </div>
      </article>`;
  }).join("");
}

function startBooking(trainId,cls,count=1) {
  if(!currentUser) {
    toast("Please log in before reserving a ticket.");
    showPage("loginPage");
    return;
  }

  if(!searchDateValue) searchDateValue=$("searchDate").value||todayISO();

  if(searchDateValue<todayISO()) {
    toast("Choose today or a future journey date.");
    return;
  }

  selectedTrain=findTrain(trainId);
  selectedClass=cls;
  bookingPassengerCount=Math.max(1,Math.min(6,Number(count)||1));
  selectedSeats=[];

  if(!selectedTrain||!CLASSES[cls]||selectedTrain.fares[cls]<=0) {
    toast("This class is not available.");
    return;
  }

  const available=getAvailableSeats(selectedTrain,cls,searchDateValue);
  if(available.length<bookingPassengerCount) {
    toast("Not enough seats available in this class.");
    return;
  }

  renderBookingForm();
  showPage("bookingPage");
}

function getAvailableSeats(train,cls,date) {
  const capacity=Math.min(40,Math.max(Number(train.seats[cls]||0),0));
  const taken=new Set(
    bookings
      .filter(b=>b.trainId===train.id&&b.date===date&&b.class===cls&&b.status!=="Cancelled")
      .flatMap(b=>b.seats||[])
      .map(String)
  );

  const result=[];
  for(let i=1;i<=capacity;i++) {
    const seat=String(i).padStart(2,"0");
    if(!taken.has(seat)) result.push(seat);
  }
  return result;
}

