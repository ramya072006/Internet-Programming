function toggleSeat(n,button) {
  if(selectedSeats.includes(n)) {
    selectedSeats=selectedSeats.filter(seat=>seat!==n);
    button.classList.remove("selected");
  } else if(selectedSeats.length>=bookingPassengerCount) {
    toast(`You can select only ${bookingPassengerCount} seat(s).`);
    return;
  } else {
    selectedSeats.push(n);
    button.classList.add("selected");
  }
  updateBookingTotals();
}

function updateBookingTotals() {
  if(!selectedTrain) return;
  $("seatCount").textContent=`Selected seats: ${selectedSeats.length}/${bookingPassengerCount} · ${selectedSeats.join(", ")||"None"}`;
  $("bookingTotals").innerHTML=`
    <div class="booking-summary">
      <div><span>Passengers</span><strong>${bookingPassengerCount}</strong></div>
      <div><span>Selected seats</span><strong>${selectedSeats.length?selectedSeats.map(safe).join(", "):"Not selected"}</strong></div>
      <div><span>Total fare</span><strong>${money(selectedTrain.fares[selectedClass]*bookingPassengerCount)}</strong></div>
    </div>`;
}

